---
// Layout.astro — the app chrome (header + bottom nav), every navigation a real
// link instead of a hash toggle. Header (Aug 2026): the league switcher lives on
// the scope sub-line under the wordmark (the old right-side "ALL ▼" pill and the
// "Questions?" mailto are gone), and the top-right slot is the site-wide
// "Get your player website" CTA to /get-started (Aug 21 2026). It keeps the
// original header:get-offers label since the destination is unchanged, so that
// dashboard column keeps its pre-Aug-16 history. The "Free D1 evaluation" ->
// /free-evaluation CTA that held the slot is kept commented out below.
// Dropdown items are <a> links (native, JS-free), the trigger toggled by a
// small inline script.
import '../styles/global.css';
import { LEAGUES, SESSION_LEAGUES } from '../lib/leagues';
import { EVAL_SEATS_LEFT } from '../lib/evalSeats.js';
import GateModal from '../components/GateModal.astro';
import MetaPixel from '../components/MetaPixel.astro';

export interface Props {
  title: string;
  description?: string;
  subLabel: string;          // header sub line (scope) — doubles as the league-switcher trigger
  pillLabel: string;         // legacy short league label — no longer rendered (kept so call sites don't all need touching)
  pageBase: string;          // url base for the 4 nav tabs, e.g. '/uaa/u15'
  activeTab: 'stats' | 'leaders' | 'compare' | 'teams' | null;
  canonical?: string;
  robots?: string;
  trackTitle?: string;       // human-readable name for analytics (player/team/matchup) — not SEO title
  hideNav?: boolean;         // drop the bottom nav (conversion pages: no exits off the page)
  hideHeader?: boolean;      // drop the site header too (page ships its own nav, e.g. /get-started)
  noPixel?: boolean;         // omit MetaPixel entirely (not even PageView) — for
                             // non-funnel pages like /intake, where any pixel
                             // event would feed ad optimization traffic that
                             // was never bought (see CLAUDE.md pixel section)
}
const { title, description = '', subLabel, pillLabel, pageBase, activeTab, canonical, robots, trackTitle, hideNav = false, hideHeader = false, noPixel = false } = Astro.props;

// Share-preview image: one static brand card for every page. Replaced the
// per-page Chromium screenshot function (api/og-shot.js, removed Aug 2026) —
// crawlers fetching ~5,800 unique screenshot URLs burned through the whole
// Vercel Hobby Active-CPU quota. Don't reintroduce per-request image rendering.
const ogImage = `${(Astro.site?.href || Astro.url.origin).replace(/\/$/, '')}/og-card.png`;

// Bottom-nav destinations (real pages). Leaders defaults to the PPG board.
const tabs = [
  { v: 'stats', label: 'Stats', href: `${pageBase}/stats` },
  { v: 'leaders', label: 'Leaders', href: `${pageBase}/leaders/ppg` },
  { v: 'compare', label: 'Compare', href: `${pageBase}/compare` },
  { v: 'teams', label: 'Teams', href: `${pageBase}/teams` },
];
const navIcons: Record<string, string> = {
  stats: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  leaders: '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>',
  compare: '<path d="M10 3H6a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h4M14 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M12 8v8M9 11l3-3 3 3"/>',
  teams: '<path d="M12 2 3 7v5c0 5.25 3.75 10.15 9 11.25C17.25 22.15 21 17.25 21 12V7L12 2z"/>',
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <script is:inline>
  // Legacy-URL shim. The pre-SEO app was one page routed by location.hash
  // (#u15/player/Name, #s2u15/stats, plus ?ref=abri&field=PPG&player=Name for
  // rank-jumps). Fragments never reach the server, so links shared before the
  // Astro cutover land on a real page with the old hash still attached —
  // translate them to the equivalent real URL before first paint. No-op unless
  // the URL carries legacy signals.
  (function () {
    var h = '';
    try { h = decodeURIComponent(location.hash.slice(1)); } catch (e) { h = location.hash.slice(1); }
    var q = new URLSearchParams(location.search);
    var hasRJ = q.has('field') && q.has('player');
    if (!h && !hasRJ) return;
    // key -> [urlBase, circuit, age, playerSlugSuffix]; combined scopes have no
    // player detail pages (circuit/age null -> fall back to the scope's /stats).
    var KEYS = {
      u15: ['/uaa/u15', 'uaa', 'u15', ''], u16: ['/uaa/u16', 'uaa', 'u16', ''], u17: ['/uaa/u17', 'uaa', 'u17', ''],
      eybl15: ['/eybl/u15', 'eybl', 'u15', ''], eybl16: ['/eybl/u16', 'eybl', 'u16', ''], eybl17: ['/eybl/u17', 'eybl', 'u17', ''],
      '3ssb15': ['/3ssb/u15', '3ssb', 'u15', ''], '3ssb16': ['/3ssb/u16', '3ssb', 'u16', ''], '3ssb17': ['/3ssb/u17', '3ssb', 'u17', ''],
      all: ['/uaa', null, null, ''], eyblall: ['/eybl', null, null, ''], '3ssball': ['/3ssb', null, null, ''],
      u15all: ['/rankings/u15', null, null, ''], u16all: ['/rankings/u16', null, null, ''], u17all: ['/rankings/u17', null, null, ''],
      allall: ['/rankings', null, null, ''],
      s2u15: ['/uaa/u15/session2', 'uaa', 'u15', '-s2'], s3u15: ['/uaa/u15/session3', 'uaa', 'u15', '-s3'],
    };
    var key = null, rest = h;
    var names = Object.keys(KEYS).sort(function (a, b) { return b.length - a.length; }); // s2u15 before u15 etc.
    for (var i = 0; i < names.length; i++) {
      if (h === names[i] || h.indexOf(names[i] + '/') === 0) { key = names[i]; rest = h.slice(names[i].length).replace(/^\//, ''); break; }
    }
    // The old ?ref=abri links could also hit /session2uaastatsu15 with no hash.
    if (!key && location.pathname === '/session2uaastatsu15') key = 's2u15';
    var TABS = { stats: 1, teams: 1, compare: 1, leaders: 1 };
    var head = rest.split('/')[0];
    var isLegacy = !!key || TABS[head] || rest.indexOf('player/') === 0 || rest.indexOf('team/') === 0;
    if (!isLegacy && !hasRJ) return;
    var m = KEYS[key || 'allall'], base = m[0], circuit = m[1], age = m[2], suffix = m[3];
    // Mirrors slugs.ts slugify() — deterministic slugs, so old #player/Name links
    // resolve without shipping the registry (rare -2 collision slugs excepted).
    function slugify(s) {
      return String(s).normalize('NFKD').replace(/[̀-ͯ]/g, '')
        .replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase() || 'x';
    }
    // Old-app rank field -> /abri* short-link key ([...path].astro ABRI_SHORT_FIELDS).
    var FIELD_SHORT = { PPG: 'ppg', RPG: 'rpg', APG: 'apg', SPG: 'spg', BPG: 'bpg', GP: 'gp',
      'FG%': 'fg', 'FT%': 'ft', _ts: 'ts', '3FG%': '3p', '3PM': '3pm', '3PM/G': '3pmg',
      'Tot PTS': 'pts', 'Tot REB': 'reb', 'Tot AST': 'ast', 'Tot STL': 'stl', 'Tot BLK': 'blk' };
    var dest = null;
    if (rest.indexOf('player/') === 0) {
      var nm = rest.slice(7);
      dest = (circuit && age) ? '/player/' + slugify(nm) + '-' + circuit + '-' + age + suffix : base + '/stats';
    } else if (rest.indexOf('team/') === 0) {
      var tm = rest.slice(5).split('~')[0]; // combined scopes encoded "Team~Group"
      dest = (circuit && age && !suffix) ? base + '/team/' + slugify(tm) : base + '/teams';
    } else if (hasRJ && (!rest || head === 'stats')) {
      // Rank-jump deep link — only ever issued for Abri (?ref=abri unlock).
      var short = FIELD_SHORT[q.get('field')];
      if (short && slugify(q.get('player')) === 'abri-fazliu' && key === 's2u15') dest = '/abri' + short;
      else if (short && slugify(q.get('player')) === 'abri-fazliu') dest = '/abriu15' + short;
      else dest = base + '/stats';
    } else if (TABS[head]) {
      dest = head === 'leaders' ? base + '/leaders/ppg' : base + '/' + head;
    } else if (key) {
      dest = base + '/stats';
    }
    if (dest && dest !== location.pathname) location.replace(dest);
  })();
  </script>
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {robots && <meta name="robots" content={robots} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Circuit Stats" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage} />
  {/* Same artwork as the .hdr-logo mark next to the wordmark (global.css). */}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <meta name="theme-color" content="#08090f" />
  {!noPixel && <MetaPixel />}
</head>
<body>
<GateModal />
{!hideHeader && <header class="hdr">
  <a class="hdr-brand" id="hdr-home" href="/" data-track="header:logo" aria-label="Circuit Stats — home">
    <div class="hdr-logo" id="hdr-logo" role="img" aria-label="Circuit Stats logo"></div>
  </a>
  <div class="hdr-info">
    <a class="hdr-title" id="hdr-title" href="/" data-track="header:logo">Circuit Stats</a>
    <div class="hdr-scope" id="league-pill" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false" onclick="toggleLeagueDropdown(event)" title="Switch league / age group" data-track="header:league-pill">
      <span class="hdr-scope-label" id="league-pill-label">{subLabel}</span><span class="hdr-scope-caret">▼</span>
      <div class="league-dropdown" id="league-dropdown">
        {SESSION_LEAGUES.map(sl => <a class="ld-item" href={`${sl.urlBase}/${activeTab === 'leaders' ? 'leaders/ppg' : activeTab === 'compare' ? 'compare' : activeTab === 'teams' ? 'teams' : 'stats'}`} data-track={`header:league-switch:${sl.key}`}>{sl.label.replace(' · Session ', ' S')}</a>)}
        {LEAGUES.map(l => <a class="ld-item" href={`${l.urlBase}/${activeTab === 'leaders' ? 'leaders/ppg' : activeTab === 'compare' ? 'compare' : activeTab === 'teams' ? 'teams' : 'stats'}`} data-track={`header:league-switch:${l.key}`}>{l.label}</a>)}
      </div>
    </div>
  </div>
  {/* Free-film-review CTA — swap back in for the link below to restore.
  <a class="hdr-cta" href="/free-evaluation" data-track="header:free-eval">
    <span class="hdr-cta-t">Free D1 evaluation</span>
    {EVAL_SEATS_LEFT > 0 && <span class="hdr-cta-n"><span class="hdr-cta-dash" aria-hidden="true">– </span>{EVAL_SEATS_LEFT} left</span>}
  </a>
  */}
  <a class="hdr-cta" href="/get-started" data-track="header:get-offers">Get your player website</a>
</header>}

<main class:list={["main", { "main-no-nav": hideNav, "main-no-hdr": hideHeader }]}>
  <slot />
</main>

{!hideNav && <nav class="nav">
  {tabs.slice(0, 2).map(t => (
    <a class:list={["nav-btn", { active: t.v === activeTab }]} data-v={t.v} href={t.href} data-track={`nav:${t.v}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={navIcons[t.v]} />
      {t.label}
    </a>
  ))}
  <button class="nav-btn" id="share-btn" title="Share this page" aria-label="Share this page" data-track="header:share">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
    </svg>
    Share
  </button>
  {tabs.slice(2).map(t => (
    <a class:list={["nav-btn", { active: t.v === activeTab }]} data-v={t.v} href={t.href} data-track={`nav:${t.v}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={navIcons[t.v]} />
      {t.label}
    </a>
  ))}
</nav>}

<script is:inline define:vars={{ trackTitleInit: trackTitle || null }}>
  // Explicit window assignment (not a bare function declaration): define:vars
  // makes Astro emit this script as a module, and modules don't leak top-level
  // function declarations onto window — the inline onclick="" attribute below
  // needs it there.
  window.toggleLeagueDropdown = function (e) {
    e.stopPropagation();
    var open = document.getElementById('league-dropdown').classList.toggle('open');
    var trigger = document.getElementById('league-pill');
    if (trigger) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
  };
  // The scope line is a div acting as the dropdown trigger — give it the
  // keyboard behavior a real button would have.
  (function () {
    var trigger = document.getElementById('league-pill');
    if (!trigger) return;
    trigger.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); window.toggleLeagueDropdown(e); }
    });
  })();
  document.addEventListener('click', function () {
    var dd = document.getElementById('league-dropdown');
    if (dd) dd.classList.remove('open');
    var trigger = document.getElementById('league-pill');
    if (trigger) trigger.setAttribute('aria-expanded', 'false');
    // Close any open "min. N makes to qualify" tooltip — verbatim from the app.
    // The button's own onclick calls stopPropagation() so opening one doesn't
    // immediately re-close it here.
    document.querySelectorAll('.pct-qual-btn.tip-open').forEach(function (b) { b.classList.remove('tip-open'); });
  });
  // ── Tracking transport ────────────────────────────────────────────────────
  // One sender for every beacon on the site. sendBeacon rather than a
  // keepalive fetch, because the events that matter most fire exactly when the
  // page is being torn down — a tap immediately followed by a tab close, and
  // the dwell beacon itself — which is the case keepalive drops. That loss was
  // biased: it silently ate the fast-bounce visitor, the one you most need to
  // count.
  //
  // sendBeacon can't send an application/json body cross-origin (it would need
  // a CORS preflight, which beacons can't perform). In production the backend
  // is same-origin via the Vercel rewrite, so this never applies; on localhost
  // dev it is a different origin, so that case falls back to fetch.
  (function () {
    var dev = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
    var API = dev ? 'http://localhost:4000/a1a2-command-center' : '/a1a2-command-center';
    var sameOrigin = !dev;
    window.csBeacon = function (path, body) {
      var url = API + path, json;
      try { json = JSON.stringify(body); } catch (e) { return; }
      try {
        if (sameOrigin && navigator.sendBeacon
          && navigator.sendBeacon(url, new Blob([json], { type: 'application/json' }))) return;
      } catch (e) {}
      try {
        fetch(url, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: json, keepalive: true,
        }).catch(function () {});
      } catch (e) {}
    };
  })();

  // Fire-and-forget visit tracking (feeds the /dashboard analytics), verbatim from the app.
  //
  // Where the visit came from is two fields, not one. `referrer` covers organic
  // and shared links; `src` is the tag we put on the link ourselves. The tag
  // used to be ?src= alone, which meant paid traffic — the traffic we pay to
  // measure — landed as "Direct": Meta's in-app browser sends no referrer at
  // all, so an ad click and someone typing the URL were the same row. The ad
  // platforms' own markers fill that in, in the same field, so nothing
  // downstream needs a second code path to read them.
  (function () {
    var q = new URLSearchParams(location.search);
    function src() {
      var tag = q.get('src');                       // our outreach-email tag wins
      if (tag) return tag;
      var utm = q.get('utm_source');
      if (utm) {
        var campaign = q.get('utm_campaign');
        return campaign ? utm + ':' + campaign : utm;
      }
      if (q.get('fbclid')) return 'meta-ad';        // Meta click id, no utm set
      if (q.get('gclid')) return 'google-ad';
      return null;
    }
    window.csBeacon('/track', {
      referrer: document.referrer || null,
      userAgent: navigator.userAgent,
      page: location.pathname + location.hash,
      src: src(),
      title: trackTitleInit,
    });
  })();

  // ── Dwell + attention ─────────────────────────────────────────────────────
  // How long they actually stayed, how far down they actually got, and — on
  // pages that register sections — how many seconds each block spent on screen.
  //
  // Time accrues only while the tab is visible, so a page abandoned in a
  // background tab never reports as an hour of reading. Depth is a continuous
  // max-scroll percentage rather than a set of hand-placed markers, so it stays
  // honest when a page's layout changes underneath it.
  //
  // Sections are the closest first-party answer to "what did they actually
  // look at" — a block that scrolled past in a flick and one that was studied
  // for thirty seconds are identical to a scroll marker, and very different
  // here.
  (function () {
    var startedAt = Date.now();
    var visibleSince = document.visibilityState === 'visible' ? startedAt : 0;
    var engagedMs = 0;
    var maxScroll = 0;
    var lastSent = -1;

    function engaged() { return engagedMs + (visibleSince ? Date.now() - visibleSince : 0); }

    function measureScroll() {
      var doc = document.documentElement;
      var h = Math.max(doc.scrollHeight || 0, document.body ? document.body.scrollHeight : 0);
      if (h <= 0) return;
      var seen = (window.scrollY || doc.scrollTop || 0) + window.innerHeight;
      var pct = Math.round(Math.max(0, Math.min(100, (seen / h) * 100)));
      if (pct > maxScroll) maxScroll = pct;
    }
    measureScroll();
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; measureScroll(); });
    }, { passive: true });

    // Pages opt in by pushing { key, el } onto window.__csSections. Their
    // markup and scripts render inside <main>, above this one, so the array is
    // already populated by the time we read it.
    var sections = [];
    (window.__csSections || []).forEach(function (s) {
      if (s && s.key && s.el) sections.push({ key: s.key, el: s.el, ms: 0, since: 0, wasOn: false });
    });
    if (sections.length && 'IntersectionObserver' in window) {
      var byEl = new Map();
      sections.forEach(function (s) { byEl.set(s.el, s); });
      var sio = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          var s = byEl.get(en.target);
          if (!s) return;
          // Half the block on screen is the bar for "being looked at" —
          // anything less is a section passing by on the way somewhere else.
          if (en.isIntersecting) { if (!s.since) s.since = Date.now(); }
          else if (s.since) { s.ms += Date.now() - s.since; s.since = 0; }
        });
      }, { threshold: 0.5 });
      sections.forEach(function (s) { sio.observe(s.el); });
    }
    // IntersectionObserver keeps reporting a section as intersecting when the
    // tab is hidden, so the section clocks are paused by hand alongside the
    // page clock.
    function pauseSections(now) {
      sections.forEach(function (s) {
        s.wasOn = !!s.since;
        if (s.since) { s.ms += now - s.since; s.since = 0; }
      });
    }
    function resumeSections(now) {
      sections.forEach(function (s) { if (s.wasOn) s.since = now; });
    }
    function sectionTimes() {
      var out = {}, now = Date.now();
      sections.forEach(function (s) {
        var ms = s.ms + (s.since ? now - s.since : 0);
        if (ms >= 1000) out[s.key] = Math.round(ms / 1000);
      });
      return out;
    }

    // Totals are cumulative, so a later beacon supersedes an earlier one rather
    // than adding to it — the dashboard takes the max per person and page, which
    // makes a duplicate harmless and lets someone who tabs away and comes back
    // be counted for the whole visit instead of only the first slice.
    function send(final) {
      var eng = Math.round(engaged() / 1000);
      var wall = Math.round((Date.now() - startedAt) / 1000);
      if (wall < 1) return;                        // sub-second: a prerender, not a visit
      if (lastSent >= 0 && eng <= lastSent) return; // nothing new since the last one
      if (!final && eng - lastSent < 3) return;
      lastSent = eng;
      measureScroll();
      window.csBeacon('/track-dwell', {
        page: location.pathname,
        seconds: eng,
        wall: wall,
        maxScrollPct: maxScroll,
        sections: sectionTimes(),
      });
    }

    document.addEventListener('visibilitychange', function () {
      var now = Date.now();
      if (document.visibilityState === 'hidden') {
        if (visibleSince) { engagedMs += now - visibleSince; visibleSince = 0; }
        pauseSections(now);
        send(false);
      } else {
        visibleSince = now;
        resumeSections(now);
      }
    });
    // pagehide catches the close/navigate case that visibilitychange misses on
    // some desktop browsers; the "nothing new" guard above stops the two from
    // writing the same number twice.
    window.addEventListener('pagehide', function () {
      var now = Date.now();
      if (visibleSince) { engagedMs += now - visibleSince; visibleSince = 0; }
      pauseSections(now);
      send(true);
    });
  })();

  // Share button: native share sheet where supported, clipboard-copy fallback
  // otherwise. Only tracked on an actual completed share/copy — a cancelled
  // native share sheet doesn't count.
  (function () {
    var btn = document.getElementById('share-btn');
    if (!btn) return;
    function toast(msg) {
      var el = document.getElementById('share-toast');
      if (!el) {
        el = document.createElement('div');
        el.id = 'share-toast';
        el.className = 'share-toast';
        document.body.appendChild(el);
      }
      el.textContent = msg;
      requestAnimationFrame(function () { el.classList.add('show'); });
      clearTimeout(el._t);
      el._t = setTimeout(function () { el.classList.remove('show'); }, 2000);
    }
    function trackShare(method) {
      window.csBeacon('/track-share', {
        page: location.pathname, title: trackTitleInit, url: location.href, method: method,
      });
    }
    btn.addEventListener('click', function () {
      // Share the URL and NOTHING else — no title, no text. Passing a title makes
      // iOS Messages (and some other targets) build their own card out of that
      // string instead of fetching the page's OG tags, which is why sharing via
      // this button used to give a plain text-only preview while pasting the same
      // URL from the address bar gave the rich one. url-only == pasted URL.
      var shareData = { url: location.href };
      if (navigator.share) {
        navigator.share(shareData).then(function () { trackShare('native'); }).catch(function () {});
      } else if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(location.href).then(function () {
          toast('Link copied!');
          trackShare('clipboard');
        }).catch(function () { toast('Could not copy link'); });
      }
    });
  })();

  // Deferred query strings. Links that need a query param (the player-page CTA
  // prefill, the compare preselect) ship a CLEAN href plus data-q, so the served
  // HTML never contains a per-player URL for a crawler to follow — that leak was
  // generating ~8,000 duplicate URLs off 4,300 real pages. We splice the query on
  // at pointerdown/keydown, i.e. before the browser navigates but after any bot has
  // read the DOM. Rewriting the href (rather than calling preventDefault) keeps
  // middle-click, ctrl-click and "open in new tab" working.
  (function () {
    function splice(e) {
      var a = e.target.closest && e.target.closest('a[data-q]');
      if (!a) return;
      var href = a.getAttribute('href') || '';
      if (href.indexOf('?') === -1) a.setAttribute('href', href + '?' + a.dataset.q);
    }
    document.addEventListener('pointerdown', splice, true);
    document.addEventListener('keydown', function (e) { if (e.key === 'Enter') splice(e); }, true);
  })();

  // Site-wide click tracking (feeds the /dashboard "Clicks" section): one
  // delegated listener catches every interactive element on every page, so
  // nothing needs its own tracking wire-up. Explicit data-track="..." on an
  // element (or ancestor) wins; otherwise a small set of known UI patterns get
  // a clean label, falling back to a generic "link"/tag-based one so nothing
  // clickable goes untracked. Capture phase so it still fires even when a
  // handler further down calls stopPropagation() (e.g. the league pill).
  (function () {
    var SELECTOR = 'a, button, input[type="search"], th[id^="th-"], .cmp-slot, .picker-item, [data-track]';
    function label(el) {
      var tracked = el.closest('[data-track]');
      if (tracked) return tracked.getAttribute('data-track');
      if (el.matches('th[id^="th-"]')) return 'stats:sort-' + el.id.slice(3);
      if (el.classList.contains('cmp-slot')) return 'compare:slot-open';
      if (el.classList.contains('picker-item')) return 'compare:pick';
      if (el.tagName === 'A') return 'link';
      if (el.tagName === 'BUTTON') return el.id ? 'button:' + el.id : 'button';
      return el.tagName.toLowerCase();
    }
    function detail(el) {
      if (el.tagName === 'A' && el.getAttribute('href')) return el.getAttribute('href');
      if (el.dataset && el.dataset.slug) return el.dataset.slug;
      if (el.id === 'league-pill') {
        var lbl = document.getElementById('league-pill-label');
        return lbl ? lbl.textContent.trim() : null;
      }
      var t = (el.textContent || '').trim().replace(/\s+/g, ' ');
      return t ? t.slice(0, 100) : null;
    }
    document.addEventListener('click', function (e) {
      var el = e.target.closest(SELECTOR);
      if (!el) return;
      window.csBeacon('/track-click', { label: label(el), detail: detail(el), page: location.pathname });
    }, true);
  })();
</script>
</body>
</html>
