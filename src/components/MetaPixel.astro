---
// Meta (Facebook) pixel. INERT until PIXEL_ID is filled in — renders nothing
// while the ID is empty, so this is safe to ship ahead of the ads launch.
// Setup: create the pixel in Meta Events Manager (business.facebook.com/events_manager),
// paste its numeric ID below, deploy, then confirm PageView fires with the
// "Meta Pixel Helper" Chrome extension. The get-started form fires a 'Lead'
// event on successful submit (see get-started.astro).
const PIXEL_ID = '1402096628471311';
---
{PIXEL_ID && (
  <script is:inline define:vars={{ PIXEL_ID }}>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', PIXEL_ID);
    fbq('track', 'PageView');
  </script>
)}
{PIXEL_ID && (
  <noscript>
    <img height="1" width="1" style="display:none" alt=""
      src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`} />
  </noscript>
)}
