---
// Meta (Facebook) pixel — LIVE. Fires PageView on every page and 'Contact' on
// any WhatsApp (wa.me) link tap; the get-started form fires 'Lead' with manual
// advanced matching (hashed email) on successful submit (see get-started.astro).
// Emptying PIXEL_ID renders nothing and turns all of this off.
const PIXEL_ID = '1402096628471311';
---
{PIXEL_ID && (
  <script is:inline define:vars={{ PIXEL_ID }}>
  (function () {

    var h = location.hostname;
    if (h === 'localhost' || h === '127.0.0.1' || h === '[::1]' || h === '::1'
        || h.endsWith('.local')
        || /^(?:10\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.)/.test(h)) {
      console.info('[MetaPixel] disabled on ' + h + ' — dev events stay out of the ad account');
      return;
    }
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', PIXEL_ID);
    fbq('track', 'PageView');

    // get-started.astro re-inits the pixel with the submitted email for manual
    // advanced matching — expose the ID so it stays single-sourced here.
    window.META_PIXEL_ID = PIXEL_ID;

    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href*="wa.me"]');
      if (!a) return;
      fbq('track', 'Contact', {
        content_category: a.getAttribute('data-track') || 'whatsapp:unlabelled',
        content_name: location.pathname,
      });
    }, true);
  })();
  </script>
)}
{PIXEL_ID && (
  <noscript>
    <img height="1" width="1" style="display:none" alt=""
      src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`} />
  </noscript>
)}
