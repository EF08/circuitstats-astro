---
// PlayerPage.astro — player stat block as a horizontal box score (ESPN-style):
// stats as columns, AVG and TOTAL rows, season-wide percentages spanning both
// rows. Reuses the team-page box-table aesthetic. Rank chips that have a
// matching leaderboard become real <a> links; chips for fields without a
// leaderboard render as plain spans.
import { calcTS, type Player } from '../lib/stats';
import type { League } from '../lib/leagues';
import { liveLabel } from '../lib/liveLabel.js';

interface Props { player: Player; league: League; }
const { player: p, league } = Astro.props as Props;
const { ranks, standings, qualMin, circuit, age, combineKind } = league;
const RANK = ranks.RANK;
const N = league.players.length;

// fields that exist as columns on the league's /stats table (TBL_COLS in
// stats.ts) — their chips deep-link there, sorted by that stat with this
// player's row highlighted, like the pre-SEO app's rank-jump. Fields without
// a table column (computed per-game makes/attempts, total TOV) stay plain spans.
const JUMP_FIELDS = new Set([
  'PPG', 'RPG', 'APG', 'SPG', 'BPG', 'TO/G', 'FG%', '3FG%', 'FT%', '_ts', '3PM/G',
  'Tot PTS', 'Tot REB', 'Tot AST', 'Tot STL', 'Tot BLK', 'FGM', 'FGA', '3PM', '3PA', 'FTM', 'FTA',
]);

function tagBadge(): string {
  if (combineKind === 'circuit' && p._age) return `<span class="age-badge">${p._age}</span>`;
  if (combineKind === 'age' && p._src) return `<span class="age-badge">${p._src || 'Multi'}</span>`;
  if (combineKind === 'all' && p._tag) return `<span class="age-badge">${p._tag}</span>`;
  return '';
}
// one-line rank chip (#37/400) for a table cell. The jump params ride in
// data-q (spliced onto the clean /stats href at pointerdown by Layout.astro),
// so crawlers never see per-player query URLs — same as the CTA/compare links.
function rk(f: string | null): string {
  if (!f) return '<span class="pp-pr-rank"></span>';
  const r = RANK[f] && RANK[f][p.Player];
  if (!r) return '<span class="pp-pr-rank"></span>';
  const inner = `#${r}<span class="of">/${N}</span>`;
  if (JUMP_FIELDS.has(f)) {
    const q = `rj=${encodeURIComponent(f)}&amp;rjp=${encodeURIComponent(p.Player)}&amp;rjr=${r}`;
    return `<a class="pp-pr-rank clickable" href="${league.urlBase}/stats" data-q="${q}" title="See full ranking">${inner}</a>`;
  }
  return `<span class="pp-pr-rank">${inner}</span>`;
}
const nd = () => `<span class="pp-no-track">—</span>`;
const nv = (v: any) => (v == null) ? nd() : v;

// one box-score cell: big value with its rank chip beneath
function cell(v: any, f: string | null, hi = false): string {
  return `<td><div class="pp-cv${hi ? ' hi' : ''}">${nv(v)}</div>${rk(f)}</td>`;
}
// TOTAL-row filler under a % column (a % has no separate season total)
const ncell = '<td><span class="pp-cn">—</span></td>';

const tov = p['TO/G'] != null ? Math.round(p['TO/G'] * p.GP) : null;
const fgmPG = p.FGM != null ? (p.FGM / p.GP).toFixed(1) : null;
const fgaPG = p.FGA != null ? (p.FGA / p.GP).toFixed(1) : null;
const paPG = p['3PA'] != null ? (p['3PA'] / p.GP).toFixed(1) : null;
const ftmPG = p.FTM != null ? (p.FTM / p.GP).toFixed(1) : null;
const ftaPG = p.FTA != null ? (p.FTA / p.GP).toFixed(1) : null;
const st = standings[p.Team];
const teamLabel = st ? `#${st.rank} ${p.Team}` : p.Team;

// team detail href (base league, or resolve via tags for combined — but detail
// pages are always rendered from a base league, so a direct slug works)
import { teamSlug, canonicalPlayerHref } from '../lib/slugs';
const teamHref = p.Team ? `${league.urlBase}/team/${teamSlug(p.Team, league)}` : '#';

// "Is this your player?" hero CTA — leads to the /get-started request form,
// prefilled with this player. The prefill rides in data-q, NOT in the href: a
// per-player query string turns one page into 4,300 crawlable duplicate URLs
// that all canonicalize back to /get-started. Layout.astro's pointerdown handler
// splices data-q onto the href at navigation time, so humans get the prefill and
// crawlers only ever see the clean URL. (&amp; so the attribute parses.)
const ctaQuery = `p=${encodeURIComponent(p.Player)}&amp;t=${encodeURIComponent(p.Team || '')}&amp;l=${encodeURIComponent(league.scopeLabel)}`;
const first = (p.Player || '').trim().split(/\s+/)[0];

// Abri's own pages don't pitch him the recruiting site he already has — they
// point scouts and coaches at it instead. The ?src= tag is how abrifazliu.com's
// dashboard attributes the visit (visitor log "Came from" + Campaigns), and the
// data-track label is how this site's /dashboard counts the click — it's wired
// into the funnel's abrifazliu.com metrics in a1a2-command-center (funnel.js L).
const isAbri = p.Player === 'Abri Fazliu';
const abriSiteHref = 'https://www.abrifazliu.com/?src=circuitstats-player-page';

// Compare button → All-Circuits compare hub with this player preselected
// (?a= is picked up by Compare.astro's island). Canonical slug: the ALL pool
// merges duplicate players onto their canonical base-league line.
// Same treatment as ctaQuery — the preselect rides in data-q so /rankings/compare
// stays a single crawlable URL instead of 3,775.
const cmpSlug = (canonicalPlayerHref(p.Player) || '').replace('/player/', '');
const compareQuery = cmpSlug ? `a=${cmpSlug}` : '';

const body = `
    <div class="pp-hero">
      <div class="pp-hero-main">
        <div class="pp-name">${p.Player}${tagBadge() ? ` ${tagBadge()}` : ''}</div>
        <a class="pp-team-link" href="${teamHref}">
          ${teamLabel}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <div class="pp-gp">${p.GP} games played</div>
        <a class="pp-compare-btn" href="/rankings/compare"${compareQuery ? ` data-q="${compareQuery}"` : ''} data-track="player-page:compare">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 3H6a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h4M14 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M12 8v8M9 11l3-3 3 3"/></svg>
          Compare ${first} vs anyone
        </a>
      </div>
      ${isAbri ? `
      <a class="pp-abri-card" href="${abriSiteHref}" target="_blank" rel="noopener" data-track="abri:scouting-site">
        <div class="pp-abri-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        </div>
        <div class="pp-abri-body">
          <div class="pp-abri-t">Full recruiting profile</div>
          <div class="pp-abri-d">Film, accolades &amp; strengths on <strong>abrifazliu.com</strong></div>
        </div>
        <svg class="pp-abri-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>` : `
      <div class="pp-cta">
        <div class="pp-cta-live" data-live-label${liveLabel() ? '' : ' style="display:none"'}>${liveLabel()}</div>
        <div class="pp-cta-t">Is this your player?</div>
        <p class="pp-cta-d">Get him a professional recruiting website while coaches are watching — players have landed <strong>multiple offers</strong> off theirs.</p>
        <div class="pp-cta-row">
          <a class="pp-cta-btn" href="/get-started" data-q="${ctaQuery}" data-track="player-site:get-offers">Learn more</a>
          <a class="pp-cta-ex" href="https://abrifazliu.com" target="_blank" rel="noopener" data-track="player-site:live-example">See live example →</a>
        </div>
      </div>`}
    </div>
    <div class="box-wrap pp-box-wrap">
      <table class="box-table pp-box">
        <thead><tr>
          <th class="sc"></th>
          <th>PTS</th><th>REB</th><th>AST</th><th>STL</th><th>BLK</th><th>TOV</th>
          <th>FG%</th><th>3P%</th><th>FT%</th>
          <th>3PM</th><th>3PA</th><th>FTM</th><th>FTA</th><th>FGM</th><th>FGA</th><th>TS%</th>
        </tr></thead>
        <tbody>
          <tr>
            <td class="sc">Avg</td>
            ${cell(p.PPG, 'PPG', true)}${cell(p.RPG, 'RPG')}${cell(p.APG, 'APG')}${cell(p.SPG, 'SPG')}${cell(p.BPG, 'BPG')}${cell(p['TO/G'], 'TO/G')}
            ${cell(p['FG%'] != null ? p['FG%'] + '%' : null, 'FG%')}${cell(p['3FG%'] != null ? p['3FG%'] + '%' : null, '3FG%')}${cell(p['FT%'] != null ? p['FT%'] + '%' : null, 'FT%')}
            ${cell(p['3PM/G'], '3PM/G')}${cell(paPG, '3PA/G')}${cell(ftmPG, 'FTM/G')}${cell(ftaPG, 'FTA/G')}${cell(fgmPG, 'FGM/G')}${cell(fgaPG, 'FGA/G')}
            ${cell(calcTS(p), '_ts')}
          </tr>
          <tr>
            <td class="sc">Total</td>
            ${cell(p['Tot PTS'], 'Tot PTS')}${cell(p['Tot REB'], 'Tot REB')}${cell(p['Tot AST'], 'Tot AST')}${cell(p['Tot STL'], 'Tot STL')}${cell(p['Tot BLK'], 'Tot BLK')}${cell(tov, 'TOV')}
            ${ncell}${ncell}${ncell}
            ${cell(p['3PM'], '3PM')}${cell(p['3PA'], '3PA')}${cell(p.FTM, 'FTM')}${cell(p.FTA, 'FTA')}${cell(p.FGM, 'FGM')}${cell(p.FGA, 'FGA')}
            ${ncell}
          </tr>
        </tbody>
      </table>
    </div>
    <div class="pp-box-note" title="Minimum ${qualMin} makes with verified attempts to qualify for percentage rankings">Percentage ranks: min. ${qualMin} made ⓘ</div>
    <div style="height:16px"></div>`;
---
<script>
  // Correct the badge to the visitor's actual date — this static page may have
  // been built in a different month than it's being viewed in. Outside live
  // periods the badge hides entirely (inline style: the class's display:flex
  // would override the hidden attribute).
  import { liveLabel } from '../lib/liveLabel.js';
  const t = liveLabel();
  document.querySelectorAll('[data-live-label]').forEach(el => {
    el.textContent = t;
    el.style.display = t ? '' : 'none';
  });
</script>
<div class="view active" id="view-player">
  <a class="back-btn" href={league.urlBase + '/stats'}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M19 12H5M12 5l-7 7 7 7"></path>
    </svg>Back
  </a>
  <div id="player-page-content" set:html={body}></div>
</div>
