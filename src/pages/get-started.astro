---
// get-started.astro — conversion landing for player websites, the destination
// of the "Get D1 offers now" hero CTA. Implements the Claude Design redesign
// ("Player Websites Sales Page"): own sticky nav (site header hidden) → hero →
// what's-on-the-line money section → live Google-search demo + the real
// abrifazliu.com embedded in a browser frame (interactive) →
// private-dashboard section → pricing + request form. Prefills
// player/team/league from query params (?p=&t=&l=) and POSTs to the
// circuitboard backend (/website-request), which stores the lead and emails
// Andy.
import Layout from '../layouts/Layout.astro';
import { liveLabel } from '../lib/liveLabel.js';
const SITE = 'https://www.circuitstats.com';
---
<Layout
  title="Get Your Player's Website | Circuit Stats"
  trackTitle="Get Started — Player Website"
  description="A professional recruiting website for your player: his own domain, highlight film, verified stats that update after every session, and a private dashboard showing which coaches opened his site and what they watched. $399 to build, then $39/month."
  subLabel="Player Websites"
  pillLabel="ALL"
  pageBase="/rankings"
  activeTab={null}
  canonical={`${SITE}/get-started`}
  hideNav
  hideHeader
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <div class="gs-page">

    <!-- NAV -->
    <nav class="gs-nav">
      <a class="gs-brand" href="/" data-track="get-started:logo">
        <div class="hdr-logo gs-nav-logo" role="img" aria-label="Circuit Stats logo"></div>
        <span class="gs-brand-txt">
          <span class="gs-brand-t">Circuit Stats</span>
          <span class="gs-brand-s">Player Websites</span>
        </span>
      </a>
      <a class="gs-btn gs-btn-nav" href="#request" data-track="get-started:nav-cta">Request my website</a>
    </nav>

    <!-- HERO -->
    <header class="gs-hero">
      <div class="gs-live" data-live-label style={liveLabel() ? undefined : 'display:none'}>{liveLabel()}</div>
      <div class="gs-eyebrow">RECRUITING WEBSITES · BUILT AND RUN FOR YOU</div>
      <h1 class="gs-h1">If a coach can't find you in 10 seconds, you don't exist.</h1>
      <p class="gs-hero-p1">We build your player a professional recruiting site on his own domain — <strong class="gs-domain">www.hisrealname.com</strong> — <strong>and it shows up at the top of Google when his name is searched.</strong> Organized film, verified stats, accolades and a private dashboard showing exactly which coaches are watching, and for how long.</p>
      <p class="gs-hero-p2">You send film and info once. We do everything else, forever.</p>
      <div class="gs-hero-ctas">
        <a class="gs-btn gs-btn-lg" href="#request" data-track="get-started:hero-cta">Request my website</a>
        <a class="gs-ghost" href="#proof" data-track="get-started:see-proof">See a real player's site ↓</a>
      </div>
    </header>

    <!-- WHAT'S ON THE LINE -->
    <section class="gs-stakes">
      <div class="gs-stakes-card">
        <div class="gs-eyebrow gs-eyebrow-dim">WHAT'S ACTUALLY ON THE LINE</div>
        <h2 class="gs-h2 gs-stakes-h2">A D1 roster spot is now worth more than most houses.</h2>
        <div class="gs-money">
          <div class="gs-mrow">
            <div class="gs-mnum gs-mnum-1">$20.5M</div>
            <div class="gs-mtxt">
              <div class="gs-mt">Per school, per year</div>
              <div class="gs-md">What each school can now pay athletes directly under the House settlement. 310 of 364 D1 schools are in.<sup>2</sup></div>
            </div>
          </div>
          <div class="gs-mrow">
            <div class="gs-mnum gs-mnum-2">$240–360K</div>
            <div class="gs-mtxt">
              <div class="gs-mt">One full D1 scholarship</div>
              <div class="gs-md">Tuition, room, board and fees at a major program run $60–90K a year — over a 4-year career.<sup>1</sup></div>
            </div>
          </div>
          <div class="gs-mrow">
            <div class="gs-mnum gs-mnum-3">$65,853</div>
            <div class="gs-mtxt">
              <div class="gs-mt">Average NIL, per player</div>
              <div class="gs-md">What the average men's college basketball player earned in NIL in 2025 — on top of the scholarship.<sup>3</sup></div>
            </div>
          </div>
        </div>
        <div class="gs-callout">
          <div class="gs-callout-t">Every one of those outcomes starts the same way: a coach opens a link and watches your film.</div>
          <a class="gs-btn gs-btn-md" href="#request" data-track="get-started:stakes-cta">Request my website</a>
        </div>
        <div class="gs-sources">
          <sup>1</sup> Florida Coastal Prep, D1 Basketball Scholarship Guide 2026 &nbsp;·&nbsp; <sup>2</sup> House v. NCAA settlement, effective July 1 2025 &nbsp;·&nbsp; <sup>3</sup> NIL Athlete Network, NIL Market Rate Insights 2025
        </div>
      </div>
    </section>

    <!-- PROOF: GOOGLE DEMO + LIVE SITE MOCK -->
    <section class="gs-proof" id="proof">
      <div class="gs-proof-head">
        <h2 class="gs-h2">This is a real player's live site.</h2>
        <div class="gs-proof-note"><strong class="gs-offers">Multiple offers</strong> came through this exact page.</div>
      </div>
      <div class="gs-google" id="gs-google">
        <div class="gs-glogo"><span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span style="color:#4285F4">g</span><span style="color:#34A853">l</span><span style="color:#EA4335">e</span></div>
        <div class="gs-gbox">
          <div class="gs-glens"></div>
          <div class="gs-gquery"><span id="gs-typed"></span><span class="gs-caret"></span></div>
        </div>
        <div class="gs-gresults" id="gs-gresults" hidden>
          <div class="gs-gres1">
            <div class="gs-gr-title">Abri Fazliu | Class of 2029 PG</div>
            <div class="gs-gr-url">https://abrifazliu.com</div>
            <div class="gs-gr-snip">6'2 PG from Toronto (Class of 2029). Elite defense and off-ball instincts. Toronto, CA/ 2010 Born 6'2 PG/ 6'5 WS/ 194 LB Player Profile "Luka Doncic with ...</div>
          </div>
          <div class="gs-gres2">
            <div class="gs-gr2-site">instagram.com</div>
            <div class="gs-gr2-title">@abri.faz · Instagram</div>
          </div>
        </div>
      </div>
      <div class="gs-eyebrow gs-eyebrow-dim gs-proof-arrow">…ONE CLICK LATER, THE COACH LANDS HERE ↓</div>
      <div class="gs-frame">
        <div class="gs-frame-bar">
          <div class="gs-dots"><span class="gs-dot"></span><span class="gs-dot"></span><span class="gs-dot"></span></div>
          <div class="gs-url">abrifazliu.com</div>
          <a class="gs-frame-open" href="https://www.abrifazliu.com" target="_blank" rel="noopener" data-track="get-started:example">His own domain ↗</a>
        </div>
        <div class="gs-embed-wrap" id="gs-embed-wrap">
          <iframe id="gs-embed" src="https://www.abrifazliu.com" title="Live example: Abri Fazliu's recruiting website" loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <!-- PRIVATE DASHBOARD -->
    <section class="gs-dash" id="gs-dash">
      <div class="gs-dash-inner">
        <div class="gs-dash-eyebrow"><span class="gs-dash-dot"></span>HIS PRIVATE DASHBOARD · WHAT ONLY YOU GET TO SEE</div>
        <h2 class="gs-dash-h2">See which coaches are watching — before anyone calls.</h2>
        <p class="gs-dash-p">Every site includes a private dashboard: who opened it, where they came from, and how long they watched film. Interest stops being a guess. It becomes a number.</p>
        <div class="gs-dash-grid">
          <div class="gs-watch">
            <div class="gs-watch-head">COACHES · WATCH TIME</div>
            <div class="gs-watch-list">
              <div class="gs-wrow gs-wrow-hot">
                <div class="gs-wtop"><div class="gs-wname">duke-blue-devils</div><div class="gs-wtime">40m 57s</div></div>
                <div class="gs-wtrack"><div class="gs-wfill" style="width:100%"></div></div>
              </div>
              <div class="gs-wrow">
                <div class="gs-wtop"><div class="gs-wname">montverde-academy</div><div class="gs-wtime">28m 12s</div></div>
                <div class="gs-wtrack"><div class="gs-wfill" style="width:69%"></div></div>
              </div>
              <div class="gs-wrow">
                <div class="gs-wtop"><div class="gs-wname">kansas-jayhawks</div><div class="gs-wtime">19m 44s</div></div>
                <div class="gs-wtrack"><div class="gs-wfill" style="width:48%"></div></div>
              </div>
              <div class="gs-wrow">
                <div class="gs-wtop"><div class="gs-wname">unc-tar-heels</div><div class="gs-wtime">14m 08s</div></div>
                <div class="gs-wtrack"><div class="gs-wfill" style="width:34%"></div></div>
              </div>
              <div class="gs-wrow">
                <div class="gs-wtop"><div class="gs-wname">gonzaga-bulldogs</div><div class="gs-wtime">8m 51s</div></div>
                <div class="gs-wtrack"><div class="gs-wfill" style="width:22%"></div></div>
              </div>
              <div class="gs-wrow">
                <div class="gs-wtop"><div class="gs-wname">uconn-huskies</div><div class="gs-wtime">2m 36s</div></div>
                <div class="gs-wtrack"><div class="gs-wfill" style="width:6.4%"></div></div>
              </div>
            </div>
          </div>
          <div class="gs-dash-col">
            <div class="gs-duke">
              <div class="gs-duke-eyebrow">WHAT 40 MINUTES MEANS</div>
              <div class="gs-duke-t">A Duke coach watched 41 minutes of this kid's film.</div>
              <div class="gs-duke-d">Nobody watches 41 minutes out of politeness. That's a coach doing homework. His family knew the interest was real — and how deep it ran — before the first call came. That's leverage no highlight tape gives you.</div>
            </div>
            <div class="gs-tiles">
              <div class="gs-tile"><div class="gs-tile-v">196</div><div class="gs-tile-l">REAL VISITORS</div></div>
              <div class="gs-tile"><div class="gs-tile-v">10h 42m</div><div class="gs-tile-l">FILM WATCHED</div></div>
              <div class="gs-tile"><div class="gs-tile-v">22</div><div class="gs-tile-l">COUNTRIES</div></div>
            </div>
            <div class="gs-dash-note">Example dashboard — actual school names were changed to protect the player's anonymity. Bots and family visits excluded; every count is a real person.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRICING + REQUEST FORM -->
    <section class="gs-request" id="request">
      <div class="gs-req-card">
        <div class="gs-price-panel">
          <div class="gs-eyebrow">THE WHOLE THING, HANDLED</div>
          <div class="gs-price-row">
            <div class="gs-price-main">$399</div>
            <div class="gs-price-alt">to build, then $39/month</div>
          </div>
          <div class="gs-checks">
            <div class="gs-check"><span>✓</span> Ranks at the top of Google for his name</div>
            <div class="gs-check"><span>✓</span> His own domain, registered to him</div>
            <div class="gs-check"><span>✓</span> His film, edited and organized</div>
            <div class="gs-check"><span>✓</span> Verified stats, updated every session</div>
            <div class="gs-check"><span>✓</span> Private dashboard: coach visits &amp; watch time</div>
            <div class="gs-check"><span>✓</span> Hosting and upkeep handled forever</div>
          </div>
          <div class="gs-roi">
            <div class="gs-roi-item">
              <div class="gs-roi-top"><div class="gs-roi-l">THIS WEBSITE</div><div class="gs-roi-v">$399</div></div>
              <div class="gs-roi-track"><div class="gs-roi-fill gs-roi-fill-site"></div></div>
            </div>
            <div class="gs-roi-item">
              <div class="gs-roi-top"><div class="gs-roi-l">ONE D1 OFFER &nbsp;<span class="gs-roi-sub">$2M NIL + $400K scholarship</span></div><div class="gs-roi-v gs-roi-v-accent">$2.4M</div></div>
              <div class="gs-roi-track"><div class="gs-roi-fill gs-roi-fill-offer"></div></div>
            </div>
            <div class="gs-roi-pill">= a 6,015× return</div>
            <div class="gs-roi-note">*No guarantee you go D1 — that part's on him.</div>
          </div>
        </div>
        <div class="gs-form-panel">
          <div id="gs-formwrap">
            <h3 class="gs-h3">Request the website</h3>
            <div class="gs-form-sub">You'll hear back within a few hours.</div>
            <form id="gs-form">
              <div class="gs-2col">
                <label class="gs-lbl"><span>PLAYER NAME <span class="gs-req-star">*</span></span><input class="gs-inp" id="gs-player" name="playerName" type="text" required maxlength="120" placeholder="e.g. Cayden Daughtry" /></label>
                <label class="gs-lbl"><span>TEAM &amp; LEAGUE</span><input class="gs-inp" id="gs-team" name="teamLeague" type="text" maxlength="160" placeholder="e.g. Florida Rebels, EYBL U17" /></label>
              </div>
              <label class="gs-lbl"><span>YOUR NAME</span><input class="gs-inp" id="gs-name" name="parentName" type="text" maxlength="120" placeholder="Parent / guardian / coach" /></label>
              <div class="gs-2col">
                <label class="gs-lbl"><span>YOUR EMAIL <span class="gs-req-star">*</span></span><input class="gs-inp" id="gs-email" name="email" type="email" required maxlength="160" placeholder="you@email.com" /></label>
                <label class="gs-lbl"><span>PHONE (OPTIONAL)</span><input class="gs-inp" id="gs-phone" name="phone" type="tel" maxlength="40" /></label>
              </div>
              <label class="gs-lbl"><span>CHANGES OR ADDITIONS YOU'D WANT (OPTIONAL)</span><textarea class="gs-inp gs-ta" id="gs-notes" name="notes" maxlength="1500" rows="3" placeholder="I want it like abrifazliu.com but with... team colors, a different film order, an academics section, etc."></textarea></label>
              <button class="gs-btn gs-btn-lg gs-submit" id="gs-submit" type="submit" data-track="get-started:submit">Request my website</button>
              <div class="gs-form-note">No payment now. We confirm details first, then build.</div>
              <div class="gs-err" id="gs-err"></div>
            </form>
          </div>
          <div class="gs-done" id="gs-done" hidden>
            <div class="gs-done-ico">✓</div>
            <h3 class="gs-done-t">Request received.</h3>
            <div class="gs-done-d">We'll reply within a few hours with next steps and what film to send. His site is usually live within days.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="gs-footer">
      <div class="gs-foot-brand">
        <span class="gs-logo gs-logo-sm">CS</span>
        <span class="gs-foot-txt"><strong>Circuit Stats</strong> · Player Websites</span>
      </div>
      <div class="gs-foot-sources">Sources: Florida Coastal Prep 2026 · House v. NCAA settlement · NIL Market Rate Insights 2025</div>
    </footer>

  </div>

  <script>
    // Correct the badge to the visitor's actual date — this static page may
    // have been built in a different month than it's being viewed in. Outside
    // live periods the badge hides entirely (inline style: the class's
    // display:flex would override the hidden attribute).
    import { liveLabel } from '../lib/liveLabel.js';
    const t = liveLabel();
    document.querySelectorAll('[data-live-label]').forEach(el => {
      el.textContent = t;
      el.style.display = t ? '' : 'none';
    });
  </script>
  <script is:inline>
    // Prefill from the player page that linked here (?p=&t=&l=).
    (function () {
      var q = new URLSearchParams(location.search);
      var p = q.get('p'), t = q.get('t'), l = q.get('l');
      if (p) {
        document.getElementById('gs-player').value = p;
        // Personalize the example domain: "Leartist Williams Jr" -> www.leartistwilliams.com
        var parts = p.trim().split(/\s+/);
        var dom = ((parts[0] || '') + (parts[1] || '')).normalize('NFKD').replace(/[^a-zA-Z]/g, '').toLowerCase();
        if (dom) document.querySelectorAll('.gs-domain').forEach(function (el) { el.textContent = 'www.' + dom + '.com'; });
      }
      var tl = [t, l].filter(Boolean).join(', ');
      if (tl) document.getElementById('gs-team').value = tl;
    })();

    // Fit the live-example iframe: desktop renders the real desktop site scaled
    // to the container; narrow screens get the site's own responsive layout.
    (function () {
      var wrap = document.getElementById('gs-embed-wrap');
      var frame = document.getElementById('gs-embed');
      var DESK = 1180;
      function fit() {
        var w = wrap.clientWidth;
        if (w < 620) {
          frame.style.width = '100%';
          frame.style.height = wrap.clientHeight + 'px';
          frame.style.transform = 'none';
        } else {
          var s = w / DESK;
          frame.style.width = DESK + 'px';
          frame.style.height = Math.round(wrap.clientHeight / s) + 'px';
          frame.style.transform = 'scale(' + s + ')';
        }
      }
      fit();
      window.addEventListener('resize', fit);
    })();

    // Google-search demo: when the card scrolls into view, type the player's
    // name, surface the results, then "click" the top one (highlight + the site
    // frame below lights up). Reduced motion jumps straight to the final state.
    (function () {
      var google = document.getElementById('gs-google');
      var typed = document.getElementById('gs-typed');
      var results = document.getElementById('gs-gresults');
      var proof = document.getElementById('proof');
      var Q = 'abri fazliu';
      var started = false;
      function finish() { typed.textContent = Q; results.hidden = false; proof.classList.add('gs-clicked'); }
      function run() {
        if (started) return;
        started = true;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { finish(); return; }
        var i = 0;
        var timer = setInterval(function () {
          i++;
          typed.textContent = Q.slice(0, i);
          if (i >= Q.length) {
            clearInterval(timer);
            setTimeout(function () { results.hidden = false; }, 350);
            setTimeout(function () { proof.classList.add('gs-clicked'); }, 1500);
          }
        }, 110);
      }
      if (!('IntersectionObserver' in window)) { finish(); return; }
      var io = new IntersectionObserver(function (entries) {
        if (entries.some(function (e) { return e.isIntersecting; })) { io.disconnect(); run(); }
      }, { threshold: 0.35 });
      io.observe(google);
    })();

    // Dashboard watch-time bars grow when the section scrolls into view.
    (function () {
      var dash = document.getElementById('gs-dash');
      function show() { dash.classList.add('in'); }
      if (!('IntersectionObserver' in window)) { show(); return; }
      var io = new IntersectionObserver(function (entries) {
        if (entries.some(function (e) { return e.isIntersecting; })) { io.disconnect(); show(); }
      }, { threshold: 0.25 });
      io.observe(dash);
      // Safety net: never leave the bars invisible.
      setTimeout(show, 4000);
    })();

    (function () {
      var form = document.getElementById('gs-form');
      // Prod goes through the Vercel rewrite (same origin); localhost dev has no
      // rewrite, so hit the locally-running backend directly.
      var API = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
        ? 'http://localhost:4000/a1a2-command-center' : '/a1a2-command-center';

      // Funnel instrumentation. The site-wide click listener in Layout already
      // records the submit *press*, but that fires before validation and says
      // nothing about people who filled fields in and gave up. These three
      // events are what make the pitch→lead drop-off diagnosable: without
      // form-start, "they didn't want it" and "the form lost them" look
      // identical on the dashboard.
      function track(label, detail) {
        try {
          fetch(API + '/track-click', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({ label: label, detail: detail || null, page: location.pathname }),
          }).catch(function () {});
        } catch (e) {}
      }
      // One-shot: the first time any field is touched, this visitor has started.
      var started = false;
      form.addEventListener('focusin', function () {
        if (started) return;
        started = true;
        track('get-started:form-start');
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = document.getElementById('gs-submit');
        var err = document.getElementById('gs-err');
        err.textContent = '';
        btn.disabled = true; btn.textContent = 'Sending…';
        fetch(API + '/website-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            playerName: form.playerName.value.trim(),
            teamLeague: form.teamLeague.value.trim(),
            parentName: form.parentName.value.trim(),
            email: form.email.value.trim(),
            phone: form.phone.value.trim(),
            notes: form.notes.value.trim(),
            fromPage: document.referrer || location.href,
          }),
        }).then(function (r) {
          if (!r.ok) throw new Error('status ' + r.status);
          track('get-started:submit-success');
          document.getElementById('gs-formwrap').hidden = true;
          document.getElementById('gs-done').hidden = false;
        }).catch(function (e) {
          // A failed submit is a lost lead that looks like a non-attempt unless
          // it's recorded — worth knowing separately from "never tried".
          track('get-started:submit-error', e && e.message);
          btn.disabled = false; btn.textContent = 'Request my website';
          err.textContent = "Couldn't send. Please try again, or email andyfazliu@hotmail.com";
        });
      });
    })();
  </script>
</Layout>

<style>
  .gs-page{
    background:#070d1a;min-height:100vh;color:#e9eef8;
    font-family:'Archivo',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  }
  .gs-eyebrow{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:12.5px;letter-spacing:.18em;color:#f2a83b}
  .gs-eyebrow-dim{font-size:12px;color:#93a1bd}
  .gs-h2{font-size:clamp(24px,3.4vw,34px);font-weight:900;letter-spacing:-.01em;margin:0}
  .gs-domain{color:#fff}

  @keyframes gsPulse{0%,100%{opacity:1}50%{opacity:.35}}
  @keyframes gsBarGrow{from{transform:scaleX(0)}to{transform:scaleX(1)}}

  /* ── BUTTONS ── */
  .gs-btn{
    display:inline-flex;align-items:center;justify-content:center;border:none;cursor:pointer;
    background:linear-gradient(180deg,#f7bd4d,#e8931f);color:#221503;font-weight:800;
    font-family:inherit;border-radius:10px;transition:filter .15s,transform .12s;
    box-shadow:0 4px 18px rgba(240,160,40,.35);white-space:nowrap;
  }
  .gs-btn:hover{filter:brightness(1.06)}
  .gs-btn:active{transform:scale(.98)}
  .gs-btn-nav{font-size:14px;padding:10px 20px}
  .gs-btn-md{font-size:16px;padding:14px 28px;border-radius:11px;box-shadow:0 5px 22px rgba(240,160,40,.35)}
  .gs-btn-lg{font-size:17px;padding:16px 32px;border-radius:12px;box-shadow:0 6px 28px rgba(240,160,40,.4)}

  /* ── NAV ── */
  .gs-nav{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    padding:18px clamp(20px,5vw,64px);border-bottom:1px solid #131d33;
    position:sticky;top:0;background:rgba(7,13,26,.92);
    backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);z-index:50;
