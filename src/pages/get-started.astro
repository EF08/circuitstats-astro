  /* ── MAIN: phone + form ── */
  .gs-main{
    max-width:1080px;margin:0 auto;
    display:grid;grid-template-columns:minmax(300px,432px) minmax(300px,1fr);
    gap:clamp(32px,5vw,72px);align-items:center;justify-content:center;
    padding:clamp(26px,4vw,44px) clamp(20px,5vw,64px) clamp(40px,6vw,64px);
  }
  @media (max-width:880px){
