---
// get-started.astro — the concise conversion page (v2, Aug 2026 test).
// Scroll data showed 75%+ of paid mobile visitors never scrolled past the old
// long-form hero, so this page inverts it: the product itself (abrifazliu.com
// live inside an iPhone) is the first and almost only thing, with a two-field
// request form beside it. Everything the old page said now hides behind one
// quiet "I want more info first" reveal — the full pitch stays available, but
// only for people who ask for it. The old page lives on, verbatim, at
// /get-started-info for reference and comparison.
// Same backend contract as before: POST /website-request via the Vercel
// rewrite, ?p=&t=&l= prefill from player pages, and the same funnel labels so
// the dashboard keeps reading (scroll-pricing now fires at the form, which is
// deliberately in the first viewport).
// Mobile pass (Aug 12 2026): on stacked layouts the iframe ate every
// mid-screen swipe (page scrolled 0px — measured with a synthesized touch
// gesture), so coarse-pointer devices get a touch shield over the screen; the
// phone is cropped to its top ~68% on mobile so $399 + form land one short
// flick down; a static snapshot sits behind the iframe while it loads; a
// sticky $399 bar covers the thumb zone (label get-started:sticky-cta, picked
// up by the site-wide [data-track] listener); inputs are 16px (iOS zoom rule).
import Layout from '../layouts/Layout.astro';
const SITE = 'https://www.circuitstats.com';
---
<Layout
  title="Get Your Player's Website | Circuit Stats"
  trackTitle="Get Started — Player Website"
  description="A professional recruiting website for your player: your own domain, highlight film, verified stats that update after every session, and a private dashboard showing which coaches opened the site and what they watched. $399 to build, then $39/month to host."
  subLabel="Player Websites"
  pillLabel="ALL"
  pageBase="/rankings"
  activeTab={null}
  canonical={`${SITE}/get-started`}
  hideNav
  hideHeader
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <div class="gs-page">

    <!-- NAV -->
    <nav class="gs-nav">
      <a class="gs-brand" href="/" data-track="get-started:logo">
        <div class="hdr-logo gs-nav-logo" role="img" aria-label="Circuit Stats logo"></div>
        <span class="gs-brand-txt">
          <span class="gs-brand-t">Circuit Stats</span>
          <span class="gs-brand-s">Player Websites</span>
        </span>
      </a>
    </nav>

    <!-- The title. The phone does the rest. -->
    <h1 class="gs-intro">Earn <strong class="gs-offers">multiple scholarship offers</strong> from your website, like Abri did.</h1>

    <!-- PHONE + FORM: no hero — the live site in the phone is the whole pitch. -->
    <section class="gs-main">

      <div class="gs-phone-col">
        <div class="iph-fit" id="iph-fit">
          <div class="iph" id="iph">
            <span class="iph-btn iph-btn-power" aria-hidden="true"></span>
            <span class="iph-btn iph-btn-vol1" aria-hidden="true"></span>
            <span class="iph-btn iph-btn-vol2" aria-hidden="true"></span>
            <div class="iph-screen">
              <!-- iOS Chrome top, rebuilt from the real screenshot: charcoal
                   status row (time · signal/wifi/battery) around the island,
                   then the omnibox pill. The pill is a real link out. -->
              <div class="iph-chrome">
                <div class="iph-status">
                  <span class="iph-time">2:37</span>
                  <div class="iph-island" aria-hidden="true"></div>
                  <span class="iph-sicons" aria-hidden="true">
                    <svg width="18" height="12" viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" fill="#fff"/><rect x="5" y="5.5" width="3" height="6.5" rx="1" fill="#fff"/><rect x="10" y="3" width="3" height="9" rx="1" fill="#ffffff59"/><rect x="15" y="0" width="3" height="12" rx="1" fill="#ffffff59"/></svg>
                    <svg width="17" height="12" viewBox="0 0 17 12"><path d="M8.5 12 L5.6 8.9 a4.4 4.4 0 0 1 5.8 0 Z" fill="#fff"/><path d="M3.4 6.5 a7.6 7.6 0 0 1 10.2 0 L11.9 8.3 a5.2 5.2 0 0 0 -6.8 0 Z" fill="#fff"/><path d="M.9 3.8 a11.4 11.4 0 0 1 15.2 0 L14.4 5.6 a9 9 0 0 0 -11.8 0 Z" fill="#fff"/></svg>
                    <svg width="25" height="12" viewBox="0 0 25 12"><rect x="0" y="0" width="21" height="12" rx="3.5" fill="none" stroke="#ffffff66" stroke-width="1"/><rect x="2" y="2" width="14" height="8" rx="2" fill="#fff"/><path d="M22.5 4 a2.5 2.5 0 0 1 0 4 Z" fill="#ffffff66"/></svg>
                  </span>
                </div>
                <a class="iph-omni" href="https://www.abrifazliu.com" target="_blank" rel="noopener" data-track="get-started:example" title="Open abrifazliu.com">
                  <svg width="17" height="17" viewBox="0 0 17 17" aria-hidden="true"><path d="M6.2 0 L7.6 4.6 L12.2 6 L7.6 7.4 L6.2 12 L4.8 7.4 L.2 6 L4.8 4.6 Z" fill="#e8eaed"/><path d="M13 9.5 L13.9 12.1 L16.5 13 L13.9 13.9 L13 16.5 L12.1 13.9 L9.5 13 L12.1 12.1 Z" fill="#e8eaed"/></svg>
                  <span class="iph-omni-url">abrifazliu.com</span>
                  <svg width="15" height="19" viewBox="0 0 15 19" aria-hidden="true"><path d="M7.5 0 L11.5 4 L10.4 5.1 L8.25 2.95 V12 H6.75 V2.95 L4.6 5.1 L3.5 4 Z" fill="#e8eaed"/><path d="M1.5 7.5 H4.5 V9 H3 V17 H12 V9 H10.5 V7.5 H13.5 V18.5 H1.5 Z" fill="#e8eaed"/></svg>
                  {/* Templated (not JS-created) so Astro's scoped styles reach it; JS only reveals it. */}
                  <div class="iph-nudge" id="iph-nudge" hidden></div>
                </a>
              </div>
              <div class="iph-view">
                {/* Snapshot of the real site shows instantly; the live iframe
                    fades in over it once loaded (on weak cellular the screen
                    used to sit black). */}
                <img class="iph-preview" id="iph-preview" src="/abri-phone-preview.webp" alt="" aria-hidden="true" />
                <iframe id="iph-frame" src="https://www.abrifazliu.com" title="Live example: Abri Fazliu's recruiting website"></iframe>
                {/* Touch devices only: swipes over the phone must scroll THIS
                    page, not the site inside it — and a tap anywhere on the
                    screen does what the nudge promises. Duplicate of the
                    omnibox link, so hidden from the a11y tree. */}
                <a class="iph-touch" href="https://www.abrifazliu.com" target="_blank" rel="noopener" data-track="get-started:example" aria-hidden="true" tabindex="-1"></a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="gs-form-col" id="get">
        <h2 class="gs-h2">Get yours today</h2>
        <div class="gs-price-row">
          <div class="gs-price-main">$399</div>
          <div class="gs-price-alt">to build, then $39/month to host · cancel anytime</div>
        </div>
        <div id="gs-formwrap">
          <form id="gs-form">
            <label class="gs-lbl"><span>PLAYER NAME <span class="gs-req-star">*</span></span><input class="gs-inp" id="gs-player" name="playerName" type="text" required maxlength="120" /></label>
            <label class="gs-lbl"><span>EMAIL <span class="gs-req-star">*</span></span><input class="gs-inp" id="gs-email" name="email" type="email" required maxlength="160" /></label>
            {/* Kept hidden so the ?t=&l= prefill from player pages still reaches the lead. */}
            <input type="hidden" id="gs-team" name="teamLeague" />
            <button class="gs-btn gs-btn-lg gs-submit" id="gs-submit" type="submit" data-track="get-started:submit">Submit</button>
            <a class="gs-wa-link" href="https://wa.me/16476079935?text=Hi%2C%20I%27m%20interested%20in%20a%20player%20website." target="_blank" rel="noopener" data-track="get-started:whatsapp-form">Prefer to talk first? WhatsApp us</a>
            <div class="gs-err" id="gs-err"></div>
          </form>
        </div>
        <div class="gs-done" id="gs-done" hidden>
          <div class="gs-done-ico">✓</div>
          <h3 class="gs-done-t">Request received.</h3>
          <div class="gs-done-d">We'll reply within a few hours with next steps and what film to send. Your site is usually live within days.</div>
        </div>

        {/* The one-line case for the price, moved up out of the reveal (Aug 2026):
            it was the last thing in the full pitch, which meant only the small
            minority who opened "I want more info first" AND read to the bottom
            ever saw it. Under the form it fills the dead space the screenshot
            showed between WhatsApp and the reveal button, and it answers the
            objection the price raises at the moment the price is on screen. */}
        {/* Two magnitudes, stated plainly. No motion and no ratio line — the
            two figures and the length of the two bars carry it. */}
        <div class="gs-roi" id="gs-roi">
          <div class="gs-roi-item gs-roi-cost">
            <div class="gs-roi-top">
              <div class="gs-roi-l">WEBSITE COST</div>
              <div class="gs-roi-v">$399</div>
            </div>
            <div class="gs-roi-track"><div class="gs-roi-fill"></div></div>
          </div>
          <div class="gs-roi-item gs-roi-prize">
            <div class="gs-roi-top">
              <div class="gs-roi-l">ONE D1 OFFER<span class="gs-roi-sub">(4-yr scholarship + average NIL)</span></div>
              <div class="gs-roi-v">$500K+</div>
            </div>
            <div class="gs-roi-track"><div class="gs-roi-fill"></div></div>
          </div>
        </div>

        <button class="gs-more-btn" id="gs-more-btn" type="button" data-track="get-started:more-info">I want more info first</button>
      </div>

    </section>

    <!-- THE FULL PITCH — hidden until asked for. Content mirrors /get-started-info. -->
    <div class="gs-more" id="gs-more" hidden>

      <!-- WHAT'S ON THE LINE -->
      <section class="gs-stakes" id="info-money">
        <h2 class="gs-h2 gs-stakes-h2">A D1 roster spot is now worth more than most houses.</h2>
        <div class="gs-money">
          <div class="gs-mrow">
            <div class="gs-mnum gs-mnum-1">$20.5M</div>
            <div class="gs-mtxt">
              <div class="gs-mt">Per school, per year</div>
              <div class="gs-md">What each school can now pay athletes directly under the <a class="gs-src-link" href="https://en.wikipedia.org/wiki/House_v._NCAA" target="_blank" rel="noopener">House v. NCAA settlement</a>. 310 of 364 D1 schools are in.<sup>2</sup></div>
            </div>
          </div>
          <div class="gs-mrow">
            <div class="gs-mnum gs-mnum-2">$240–360K</div>
            <div class="gs-mtxt">
              <div class="gs-mt">One full D1 scholarship</div>
              <div class="gs-md">Tuition, room, board and fees at a major program run $60–90K a year — over a 4-year career.<sup>1</sup></div>
            </div>
          </div>
          <div class="gs-mrow">
            <div class="gs-mnum gs-mnum-3">$65,853</div>
            <div class="gs-mtxt">
              <div class="gs-mt">Average NIL, per player</div>
              <div class="gs-md">What the average men's college basketball player earned in NIL in 2025 — on top of the scholarship.<sup>3</sup></div>
            </div>
          </div>
        </div>
        <p class="gs-callout-t">The coaches who decide who gets this money are already recruiting on <a class="gs-cs-link" href="/" target="_blank" rel="noopener" data-track="get-started:circuitstats-link">Circuit Stats</a>, the national stats site for EYBL, UAA &amp; 3SSB. From the site's visitor log:</p>
        <div class="gs-vlog">
          <div class="gs-vrow">
            <div class="gs-vtop"><div class="gs-vorg">University of North Carolina at Chapel Hill</div><div class="gs-vtime">recently</div></div>
            <div class="gs-vsub">Chapel Hill, NC · viewed Xavier Young, Texas Impact film, U17 scoring leaders</div>
          </div>
          <div class="gs-vrow">
            <div class="gs-vtop"><div class="gs-vorg">University of Michigan</div><div class="gs-vtime">recently</div></div>
            <div class="gs-vsub">New Hudson, MI · viewed Merrick Ham</div>
          </div>
          <div class="gs-vrow">
            <div class="gs-vtop"><div class="gs-vorg">Cleveland Cavaliers</div><div class="gs-vtime">2d ago</div></div>
            <div class="gs-vsub">Cleveland, OH · viewed Flory Kuminga, EYBL U15 stats</div>
          </div>
          <div class="gs-vrow">
            <div class="gs-vtop"><div class="gs-vorg">Illinois State University</div><div class="gs-vtime">3d ago</div></div>
            <div class="gs-vsub">Normal, IL · viewed Alexander Sirbu</div>
          </div>
        </div>
        <div class="gs-vnote">Real visits from the tracking log — the organization is identified from the network the visit came from; the names are the players they viewed.</div>
        <p class="gs-callout-t gs-callout-close">We build your website on your own domain, then put your website link on <a class="gs-cs-link" href="/" target="_blank" rel="noopener" data-track="get-started:circuitstats-link">Circuit Stats</a> — so the next player they find is yours. <a class="gs-callout-link" href="#get" data-track="get-started:stakes-cta">Create yours today.</a></p>
        <div class="gs-sources">
          <sup>1</sup> <a class="gs-src-link" href="https://floridacoastalprep.com/d1-basketball-scholarship-guide/" target="_blank" rel="noopener">Florida Coastal Prep, D1 Basketball Scholarship Guide 2026</a> &nbsp;·&nbsp; <sup>2</sup> <a class="gs-src-link" href="https://en.wikipedia.org/wiki/House_v._NCAA" target="_blank" rel="noopener">House v. NCAA settlement, effective July 1 2025</a> &nbsp;·&nbsp; <sup>3</sup> <a class="gs-src-link" href="https://gameplannil.substack.com/p/nil-market-rate-insights-2025" target="_blank" rel="noopener">NIL Athlete Network, NIL Market Rate Insights 2025</a>
        </div>
      </section>

      <!-- GOOGLE DEMO -->
      <section class="gs-proof" id="info-example">
        <div class="gs-proof-head">
          <h2 class="gs-h2">We make sure your site appears top of Google.</h2>
        </div>
        <a class="gs-google" id="gs-google" href="https://www.abrifazliu.com" target="_blank" rel="noopener" data-track="get-started:example" aria-label="Open abrifazliu.com — the real top result">
          <div class="gs-glogo"><span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span style="color:#4285F4">g</span><span style="color:#34A853">l</span><span style="color:#EA4335">e</span></div>
          <div class="gs-gbox">
            <div class="gs-glens"></div>
            <div class="gs-gquery"><span id="gs-typed"></span><span class="gs-caret"></span></div>
          </div>
          <div class="gs-gresults" id="gs-gresults" hidden>
            <div class="gs-gres1">
              <div class="gs-gr-title">Abri Fazliu | Class of 2029 PG</div>
              <div class="gs-gr-url">https://abrifazliu.com</div>
              <div class="gs-gr-snip">6'2 PG from Toronto (Class of 2029). Elite defense and off-ball instincts. Toronto, CA/ 2010 Born 6'2 PG/ 6'5 WS/ 194 LB Player Profile "Luka Doncic with ...</div>
            </div>
            <div class="gs-gres2">
              <div class="gs-gr2-site">instagram.com</div>
              <div class="gs-gr2-title">@abri.faz · Instagram</div>
            </div>
          </div>
        </a>
      </section>

      <!-- PRIVATE DASHBOARD -->
      <section class="gs-dash" id="info-dash">
        <div class="gs-dash-inner">
          <h2 class="gs-dash-h2">See which coaches are watching — before anyone calls.</h2>
          <p class="gs-dash-p">Every site includes a private dashboard: who opened it, where they came from, and how long they watched film. Interest stops being a guess. It becomes a number.</p>
          <div class="gs-dash-grid">
            <div class="gs-watch">
              <div class="gs-watch-head">COACHES · WATCH TIME</div>
              <div class="gs-watch-list">
                <div class="gs-wrow gs-wrow-hot">
                  <div class="gs-wtop"><div class="gs-wname">duke-blue-devils</div><div class="gs-wtime">40m 57s</div></div>
                  <div class="gs-wtrack"><div class="gs-wfill" style="width:100%"></div></div>
                </div>
                <div class="gs-wrow">
                  <div class="gs-wtop"><div class="gs-wname">montverde-academy</div><div class="gs-wtime">28m 12s</div></div>
                  <div class="gs-wtrack"><div class="gs-wfill" style="width:69%"></div></div>
                </div>
                <div class="gs-wrow">
                  <div class="gs-wtop"><div class="gs-wname">kansas-jayhawks</div><div class="gs-wtime">19m 44s</div></div>
                  <div class="gs-wtrack"><div class="gs-wfill" style="width:48%"></div></div>
                </div>
                <div class="gs-wrow">
                  <div class="gs-wtop"><div class="gs-wname">unc-tar-heels</div><div class="gs-wtime">14m 08s</div></div>
                  <div class="gs-wtrack"><div class="gs-wfill" style="width:34%"></div></div>
                </div>
                <div class="gs-wrow">
                  <div class="gs-wtop"><div class="gs-wname">gonzaga-bulldogs</div><div class="gs-wtime">8m 51s</div></div>
                  <div class="gs-wtrack"><div class="gs-wfill" style="width:22%"></div></div>
                </div>
                <div class="gs-wrow">
                  <div class="gs-wtop"><div class="gs-wname">uconn-huskies</div><div class="gs-wtime">2m 36s</div></div>
                  <div class="gs-wtrack"><div class="gs-wfill" style="width:6.4%"></div></div>
                </div>
              </div>
            </div>
            <div class="gs-dash-col">
              <div class="gs-duke">
                <div class="gs-duke-t">A Duke coach watched 41 minutes of this kid's film.</div>
                <div class="gs-duke-d">Nobody watches 41 minutes out of politeness. That's a coach doing homework. The family knew the interest was real — and how deep it ran — before the first call came. That's leverage no highlight tape gives you.</div>
              </div>
              <div class="gs-tiles">
                <div class="gs-tile"><div class="gs-tile-v">196</div><div class="gs-tile-l">REAL VISITORS</div></div>
                <div class="gs-tile"><div class="gs-tile-v">10h 42m</div><div class="gs-tile-l">FILM WATCHED</div></div>
                <div class="gs-tile"><div class="gs-tile-v">22</div><div class="gs-tile-l">COUNTRIES</div></div>
              </div>
              <div class="gs-dash-note">Example dashboard — actual school names were changed to protect the player's anonymity. Bots and family visits excluded; every count is a real person.</div>
            </div>
          </div>
        </div>
      </section>

      <!-- WHAT'S INCLUDED + ROI -->
      <section class="gs-included" id="info-included">
        <h2 class="gs-h2">The whole thing, handled.</h2>
        <div class="gs-checks">
          <div class="gs-check"><span>✓</span> Connect website to Circuit Stats, where D1 &amp; NBA teams scout</div>
          <div class="gs-check"><span>✓</span> Ranks at the top of Google for your name</div>
          <div class="gs-check"><span>✓</span> Your own domain, registered to you</div>
          <div class="gs-check"><span>✓</span> Your film, edited and organized</div>
          <div class="gs-check"><span>✓</span> Verified stats, updated every session</div>
          <div class="gs-check"><span>✓</span> Private dashboard: coach visits &amp; watch time</div>
          <div class="gs-check"><span>✓</span> Hosting and upkeep handled forever</div>
          <div class="gs-check"><span>✓</span> Cancel anytime</div>
        </div>
        <a class="gs-btn gs-btn-lg gs-back-btn" href="#get" data-track="get-started:info-cta">Get your website today</a>
      </section>

    </div>

    <!-- MOBILE STICKY CTA: the price + the way to the form, always in the
         thumb zone. Appears once the visitor is past the headline, hides
         while the form itself is on screen and for good after a submit. -->
    <a class="gs-sticky" id="gs-sticky" href="#get" data-track="get-started:sticky-cta">
      <span class="gs-sticky-price">$399</span>
      <span class="gs-sticky-txt">Get yours today</span>
    </a>

    <!-- FOOTER -->
    <footer class="gs-footer">
      <div class="gs-foot-brand">
        <div class="hdr-logo gs-foot-logo" role="img" aria-label="Circuit Stats logo"></div>
        <span class="gs-foot-txt"><strong>Circuit Stats</strong> · Player Websites</span>
      </div>
      <div class="gs-foot-contact"><span class="gs-foot-q">Questions?</span><a href="mailto:andyfazliu@gmail.com" data-track="get-started:contact">Email us</a> &nbsp;·&nbsp; <a href="tel:+16476079935" data-track="get-started:call">Call us</a> &nbsp;·&nbsp; <a href="https://wa.me/16476079935" target="_blank" rel="noopener" data-track="get-started:whatsapp">WhatsApp</a></div>
    </footer>

  </div>

  <script is:inline>
    // Prod goes through the Vercel rewrite (same origin); localhost dev has no
    // rewrite, so hit the locally-running backend directly.
    var API = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
      ? 'http://localhost:4000/a1a2-command-center' : '/a1a2-command-center';

    // Funnel instrumentation, shared by the scroll tracker, the more-info
    // reveal and the form. Labels must stay in sync with
    // a1a2-command-center/apps/circuitboard/funnel.js.
    //
    // Routed through Layout's csBeacon (sendBeacon) so an event fired on the
    // way out — a WhatsApp tap, a submit, the last section reached — survives
    // the page being torn down. Layout's script runs after this one in document
    // order, so csBeacon is resolved at call time, never at definition time.
    function track(label, detail) {
      if (window.csBeacon) {
        window.csBeacon('/track-click', { label: label, detail: detail || null, page: location.pathname });
        return;
      }
      try {
        fetch(API + '/track-click', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          keepalive: true,
          body: JSON.stringify({ label: label, detail: detail || null, page: location.pathname }),
        }).catch(function () {});
      } catch (e) {}
    }

    // Sections whose on-screen time Layout's dwell tracker should clock. This
    // is the part that answers "what did they actually look at": a scroll
    // marker can only say a block went past, which is the same event whether
    // they flicked through it or read it. Registered here, measured there.
    (function () {
      var SECTIONS = [
        ['gs-phone',   '.gs-phone-col'],   // the live site in the iPhone
        ['gs-form',    '#get'],            // price + request form
        ['roi',        '#gs-roi'],         // $399 vs $500K, under the form
        ['money',      '#info-money'],
        ['example',    '#info-example'],
        ['dashboard',  '#info-dash'],
        ['included',   '#info-included'],
      ];
      window.__csSections = window.__csSections || [];
      SECTIONS.forEach(function (s) {
        var el = document.querySelector(s[1]);
        if (el) window.__csSections.push({ key: s[0], el: el });
      });
    })();

    // Prefill from the player page that linked here (?p=&t=&l=).
    (function () {
      var q = new URLSearchParams(location.search);
      var p = q.get('p'), t = q.get('t'), l = q.get('l');
      if (p) document.getElementById('gs-player').value = p;
      var tl = [t, l].filter(Boolean).join(', ');
      if (tl) document.getElementById('gs-team').value = tl;
    })();

    // Fit the phone: the device is authored at 402x844 CSS px (real iPhone
    // scale) and shrinks as one object to whatever width its column offers.
    (function () {
      var wrap = document.getElementById('iph-fit');
      var phone = document.getElementById('iph');
      var W = 402, H = 844;
      var CROP = window.matchMedia('(max-width:880px)');
      function fit() {
        var w = wrap.clientWidth;
        if (!w) return; // pre-layout call — the observer re-fires with the real width
        var s = Math.min(1, w / W);
        phone.style.transform = 'scale(' + s + ')';
        // Stacked layout shows the top ~68% of the phone — chrome, name,
        // profile, accolades: the persuasion — so the $399 + form land one
        // short flick down instead of a full phone-height away. 68 not 72:
        // at 72 the cut landed on the glow of abrifazliu.com's own "Tap any
        // stat to verify" tooltip, which glistened through the fade.
        wrap.style.height = Math.round(H * s * (CROP.matches ? 0.68 : 1)) + 'px';
      }
      fit();
      // ResizeObserver instead of a bare resize listener: on mobile the first
      // synchronous call can land before layout has given the wrapper its
      // width (which froze the phone at scale(0)); the observer fires again
      // the moment the real width exists, and on every later change.
      if ('ResizeObserver' in window) new ResizeObserver(fit).observe(wrap);
      else window.addEventListener('resize', fit);
    })();

    // Fade the live iframe in over the static snapshot once it loads. The 7s
    // failsafe covers a load event that slipped past this listener — worst
    // case the snapshot (same pixels as the live top) just stays.
    (function () {
      var frame = document.getElementById('iph-frame');
      var pv = document.getElementById('iph-preview');
      if (!frame || !pv) return;
      function live() { pv.classList.add('iph-preview-off'); }
      frame.addEventListener('load', live);
      setTimeout(live, 7000);
    })();

    // Mobile sticky CTA: shown past the headline, hidden whenever the form is
    // on screen (it would be pointing at itself) and permanently after a
    // successful submit. The site-wide [data-track] listener logs the taps.
    (function () {
      var bar = document.getElementById('gs-sticky');
      var get = document.getElementById('get');
      if (!bar || !get) return;
      var mq = window.matchMedia('(max-width:880px)');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var formOnScreen = true; // stays true (bar hidden) until the observer reports
      function update() {
        bar.classList.toggle('on', mq.matches && !formOnScreen && !bar.dataset.done && window.scrollY > 250);
      }
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { formOnScreen = en.isIntersecting; });
          update();
        }, { rootMargin: '0px 0px -40px 0px' }).observe(get);
      } else { formOnScreen = false; }
      window.addEventListener('scroll', update, { passive: true });
      bar.addEventListener('click', function (e) {
        e.preventDefault();
        get.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    })();

    // "I want more info first": reveal the full pitch below the fold without
    // yanking the visitor — the page grows under them, plus one gentle nudge
    // so the new content's top edge is visible.
    (function () {
      var btn = document.getElementById('gs-more-btn');
      var more = document.getElementById('gs-more');
      btn.addEventListener('click', function () {
        more.hidden = false;
        btn.setAttribute('disabled', '');
        btn.classList.add('gone');
        // One gentle nudge — the reveal's top edge rises to ~60% down the
        // viewport so the visitor sees the page grew, without being yanked
        // away from the form.
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        setTimeout(function () {
          var top = more.getBoundingClientRect().top - window.innerHeight * 0.6;
          window.scrollBy({ top: top, behavior: reduce ? 'auto' : 'smooth' });
        }, reduce ? 0 : 120);
      });
    })();

    // The proof-of-life sequence. 1) When the phone enters the viewport, we
    // ask the embedded site to scroll ITSELF down ~330px and back (postMessage
    // — we own abrifazliu.com, so the site carries a small origin-gated demo
    // handler; a cross-origin parent could never scroll it directly). Real
    // content moving is the only "this is live" signal that needs no
    // explanation, and the site's own layout stays pixel-authentic. 2) When
    // the site reports done — or after a 6s fallback if the deployed site
    // predates the handler — the URL nudge appears: abrifazliu.com's "Tap any
    // stat to verify" tooltip, same recipe (gold pill, caret, pulse ring,
    // fade on first interaction — plus window blur, since tapping INTO the
    // iframe steals focus, the one interaction the parent can't hear).
    (function () {
      var frame = document.getElementById('iph-frame');
      var omni = document.querySelector('.iph-omni');
      var tip = document.getElementById('iph-nudge');
      if (!frame) return;
      var ABRI = 'https://www.abrifazliu.com';
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function showNudge() {
        if (!omni || !tip || tip.dataset.shown) return;
        tip.dataset.shown = '1';
        tip.textContent = window.matchMedia('(hover:none) and (pointer:coarse)').matches
          ? 'Tap to view full site' : 'Click to view full site';
        tip.hidden = false;
        omni.classList.add('iph-nudge-on');
        var gone = false;
        function dismiss() {
          if (gone) return;
          gone = true;
          tip.classList.add('nudge-out');
          omni.classList.remove('iph-nudge-on');
          setTimeout(function () { tip.remove(); }, 420);
        }
        // The nudge stays until they do the thing it asks for. It used to clear
        // on any click, on the first scroll, and on window blur (which fires
        // just from tapping into the iframe, or switching tabs) — so most
        // visitors lost the only instruction telling them the phone is a real
        // site they can open. Now only the two links that actually open
        // abrifazliu.com retire it.
        document.addEventListener('click', function (e) {
          if (e.target.closest && e.target.closest('.iph-omni, .iph-touch')) dismiss();
        }, true);
      }

      var nudgeTimer = null;
      window.addEventListener('message', function (e) {
        if (e.origin === ABRI && e.data && e.data.type === 'gs-demo-done') {
          clearTimeout(nudgeTimer);
          setTimeout(showNudge, 400);
        }
      });

      function demo() {
        try { frame.contentWindow.postMessage({ type: 'gs-scroll-demo' }, ABRI); } catch (err) {}
        nudgeTimer = setTimeout(showNudge, 6000);
      }

      if (reduce) { setTimeout(showNudge, 2000); return; }
      // Fire only once the iframe has loaded AND the phone is in view.
      var loaded = false, visible = false, fired = false;
      function maybe() {
        if (fired || !loaded || !visible) return;
        fired = true;
        setTimeout(demo, 700);
      }
      frame.addEventListener('load', function () { loaded = true; maybe(); });
      if (!('IntersectionObserver' in window)) { visible = true; maybe(); return; }
      var io = new IntersectionObserver(function (entries) {
        if (entries.some(function (e) { return e.isIntersecting; })) { io.disconnect(); visible = true; maybe(); }
      }, { threshold: 0.35 });
      io.observe(frame);
    })();

    // Scroll depth: one event per section, the first time it comes into view.
    // scroll-pricing is the form block (first viewport by design); the rest
    // live inside the reveal, so they only ever fire for people who asked for
    // the info. Labels sync with circuitboard/funnel.js.
    //
    // These markers are coarse by nature — the continuous max-scroll figure in
    // Layout's dwell beacon is what actually measures depth on this page, since
    // most of it sits above a reveal that changes the page height. The markers
    // stay because they name *which* argument was reached, which a percentage
    // can't.
    (function () {
      if (!('IntersectionObserver' in window)) return;
      var SECTIONS = [
        ['#get',           'get-started:scroll-pricing'],
        ['#info-money',    'get-started:scroll-money'],
        ['#info-example',  'get-started:scroll-example'],
        ['#info-dash',     'get-started:scroll-dashboard'],
        ['#info-included', 'get-started:scroll-included'],
      ];
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          io.unobserve(en.target);
          track(en.target.getAttribute('data-gs-section'));
        });
      }, { rootMargin: '0px 0px -30% 0px' });
      SECTIONS.forEach(function (s) {
        var el = document.querySelector(s[0]);
        if (el) { el.setAttribute('data-gs-section', s[1]); io.observe(el); }
      });
    })();

    // Google-search demo (inside the reveal): types the name, surfaces the
    // results, then highlights the top one. Reduced motion jumps to the end.
    (function () {
      var google = document.getElementById('gs-google');
      var typed = document.getElementById('gs-typed');
      var results = document.getElementById('gs-gresults');
      var proof = document.getElementById('info-example');
      var Q = 'abri fazliu';
      var started = false;
      function finish() { typed.textContent = Q; results.hidden = false; proof.classList.add('gs-clicked'); }
      function run() {
        if (started) return;
        started = true;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { finish(); return; }
        var i = 0;
        var timer = setInterval(function () {
          i++;
          typed.textContent = Q.slice(0, i);
          if (i >= Q.length) {
            clearInterval(timer);
            setTimeout(function () { results.hidden = false; }, 350);
            setTimeout(function () { proof.classList.add('gs-clicked'); }, 1500);
          }
        }, 110);
      }
      if (!('IntersectionObserver' in window)) { finish(); return; }
      var io = new IntersectionObserver(function (entries) {
        if (entries.some(function (e) { return e.isIntersecting; })) { io.disconnect(); run(); }
      }, { threshold: 0.35 });
      io.observe(google);
    })();

    // Dashboard watch-time bars grow when scrolled into view.
    (function () {
      [['info-dash', 'in']].forEach(function (pair) {
        var el = document.getElementById(pair[0]);
        if (!el) return;
        function show() { el.classList.add(pair[1]); }
        if (!('IntersectionObserver' in window)) { show(); return; }
        var io = new IntersectionObserver(function (entries) {
          if (entries.some(function (e) { return e.isIntersecting; })) { io.disconnect(); show(); }
        }, { threshold: 0.25 });
        io.observe(el);
        setTimeout(show, 6000); // safety net once revealed
      });
    })();

    (function () {
      var form = document.getElementById('gs-form');
      // One-shot: the first time any field is touched, this visitor has started.
      var started = false;
      form.addEventListener('focusin', function () {
        if (started) return;
        started = true;
        track('get-started:form-start');
      });

      // Per-field progress, one event per field, the first time it holds real
      // input. form-start alone can't tell "typed a name and an email, then
      // hesitated" from "brushed a field by accident" — and those two want
      // opposite responses from you. Fired on the value, not on focus, so a
      // tab-through doesn't read as filling anything in.
      ['player', 'email'].forEach(function (key) {
        var el = document.getElementById('gs-' + key);
        if (!el) return;
        var fired = false;
        el.addEventListener('input', function () {
          if (fired || !el.value.trim()) return;
          fired = true;
          track('get-started:field-' + key);
        });
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = document.getElementById('gs-submit');
        var err = document.getElementById('gs-err');
        err.textContent = '';
        btn.disabled = true; btn.textContent = 'Sending…';
        fetch(API + '/website-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            playerName: form.playerName.value.trim(),
            teamLeague: form.teamLeague.value.trim(),
            parentName: '',
            email: form.email.value.trim(),
            phone: '',
            notes: '',
            fromPage: document.referrer || location.href,
          }),
        }).then(function (r) {
          if (!r.ok) throw new Error('status ' + r.status);
          track('get-started:submit-success');
          // Meta ads conversion: a completed request is the Lead event the ad
          // campaigns optimize toward. No-op until the pixel is live (MetaPixel.astro).
          if (window.fbq) window.fbq('track', 'Lead');
          document.getElementById('gs-formwrap').hidden = true;
          document.getElementById('gs-done').hidden = false;
          // Lead is in — retire the sticky bar for this visit.
          var sb = document.getElementById('gs-sticky');
          if (sb) { sb.dataset.done = '1'; sb.classList.remove('on'); }
        }).catch(function (e) {
          track('get-started:submit-error', e && e.message);
          btn.disabled = false; btn.textContent = 'Submit';
          err.textContent = "Couldn't send. Please try again, or email andyfazliu@hotmail.com";
        });
      });
    })();
  </script>
</Layout>

<style>
