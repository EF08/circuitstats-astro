    .gs-form-col{width:100%;max-width:460px}
  }

  /* ── THE PHONE ── authored at real-iPhone CSS size (402x844), scaled to fit
     its column as one object. Frame is a dark titanium band with a machined
     highlight edge; the screen is the live site itself. */
  /* width:100% matters: the phone inside is absolutely positioned, so without
     it the collapsed mobile grid sizes this column to zero and the phone
     disappears. */
  .gs-phone-col{display:flex;flex-direction:column;align-items:center;width:100%}
  /* The phone is absolutely positioned inside the fit wrapper so its authored
     402px layout box can never widen the grid — the wrapper owns the layout
     footprint (JS sets its height to the scaled device height). */
  .iph-fit{width:min(402px,100%);position:relative}
  @media (prefers-reduced-motion: no-preference){
    .iph-fit{animation:gsRise .7s cubic-bezier(.16,1,.3,1) both}
  }
  /* Stacked layout crops the phone to its top ~68% (height math in fit()).
     clip-path instead of overflow so the frame's soft shadow survives on the
     top and sides; only the bottom is cut, and the cut edge fades into the
     page so the phone reads as continuing, not broken. */
  @media (max-width:880px){
    .iph-fit{clip-path:inset(-90px -90px 0 -90px)}
    .iph-fit::after{
      content:'';position:absolute;left:0;right:0;bottom:0;height:76px;
      z-index:4;pointer-events:none;
      background:linear-gradient(to bottom,rgba(7,13,26,0),#070d1a 92%);
    }
  }
  .iph{
