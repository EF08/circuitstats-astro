  /* The embedded site's own scrollbar can't be styled cross-origin, so the
     screen clips it: the iframe runs one scrollbar-width wider than visible. */
  /* Column, not row: with row-direction flex the iframe's flex:1 sizes its
     WIDTH and cancels the +16px scrollbar clip below. */
  .iph-view{position:relative;flex:1;display:flex;flex-direction:column}
  .iph-screen iframe{border:0;width:calc(100% + 16px);flex:1;display:block;background:#0a0a0b}
  /* The snapshot paints above the iframe until the live site loads — but
     only on phones/tablets. There overlay scrollbars give the live site the
     same 396px layout width the snapshot was shot at, and left-top pinning
     hides the same 16px right strip the iframe clip does, so the crossfade
     is pixel-aligned. Desktop's classic scrollbar lays the live site out
     ~17px narrower — every line rewraps under the fade ("shifty") — and
     desktop connections never needed the placeholder anyway. */
  .iph-preview{
    display:none;
    position:absolute;top:0;left:0;width:100%;height:100%;
    object-fit:cover;object-position:left top;pointer-events:none;
    transition:opacity .3s ease;
  }
  @media (hover:none) and (pointer:coarse){
    .iph-preview{display:block}
  }
  .iph-preview-off{opacity:0}
  /* Coarse pointers: the shield keeps swipes scrolling the page (the iframe
     consumed every mid-screen gesture) and makes any tap open the real site. */
  .iph-touch{display:none;position:absolute;inset:0;z-index:3}
  @media (hover:none) and (pointer:coarse){
    .iph-touch{display:block}
    .iph-screen iframe{pointer-events:none}
  }
  /* URL nudge — abrifazliu's "Tap any stat to verify" tooltip, verbatim
     (its gold #d4a94a, pop, caret, pulse ring, fade), mirrored to hang
     below the omnibox since the status bar leaves no room above. */
  .iph-omni{position:relative}
  .iph-nudge{
    position:absolute;top:calc(100% + 10px);left:50%;transform:translateX(-50%);
    background:#d4a94a;color:#111;font-size:15px;font-weight:700;letter-spacing:.02em;
    white-space:nowrap;padding:7px 11px;border-radius:7px;pointer-events:none;z-index:500;
    box-shadow:0 4px 18px rgba(212,169,74,.45);
    animation:nudgePop .35s cubic-bezier(.34,1.56,.64,1) both;
  }
  .iph-nudge::after{
    content:'';position:absolute;bottom:100%;left:50%;transform:translateX(-50%);
    border:6px solid transparent;border-bottom-color:#d4a94a;
  }
  @keyframes nudgePop{
    from{opacity:0;transform:translateX(-50%) translateY(-6px) scale(.9)}
    to{opacity:1;transform:translateX(-50%) translateY(0) scale(1)}
  }
  .iph-nudge.nudge-out{animation:nudgeFade .4s ease forwards}
  @keyframes nudgeFade{
    to{opacity:0;transform:translateX(-50%) translateY(4px) scale(.95)}
  }
  .iph-omni.iph-nudge-on::before{
    content:'';position:absolute;inset:-3px;border-radius:25px;
    border:2px solid #d4a94a;opacity:0;pointer-events:none;
    animation:nudgePulse 1.6s ease-in-out infinite;
