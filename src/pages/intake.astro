---
// intake.astro — the pipeline intake link (Aug 2026).
//
// A URL Andy sends by hand to a prospect he is ALREADY talking to (WhatsApp,
// phone, in person): the same wizard as /get-started, minus everything
// transactional — no pricing, no add-ons slide, no quote, no Stripe. The brief
// still files to website_intakes + website_requests and still emails Andy,
// carrying source:'pipeline' so no funnel or dashboard number counts it (the
// backend filters it out of getFunnelStats, /dashboard/leads and
// awaitingPayment).
//
// TRACKING SILENCE IS STRUCTURAL, NOT POLICED: this page never defines
// window.csTrack, so every funnel track() inside the wizard is a no-op by its
// own guard; noPixel omits MetaPixel entirely, so every fbq() call is a no-op
// the same way. Do not add either helper here — the quiet is the feature.
// (Layout's generic click logger still writes 'button:*' rows with
// page=/intake; no funnel reader consumes those.)
//
// noindex: this is a hand-delivered link, not a destination. There is nothing
// here for a stranger — no pitch, no price — and a search engine surfacing a
// bare form would only confuse the funnel's story.
import Layout from '../layouts/Layout.astro';
import IntakeWizard from '../components/IntakeWizard.astro';
---
<Layout
  title="Player Website Intake | Circuit Stats"
  trackTitle="Pipeline Intake"
  description=""
  subLabel="Player Websites"
  pillLabel="ALL"
  pageBase="/rankings"
  activeTab={null}
  robots="noindex, nofollow"
  hideNav
  hideHeader
  noPixel
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <div class="pi-page">
    <nav class="pi-nav">
      <div class="hdr-logo pi-logo" role="img" aria-label="Circuit Stats logo"></div>
      <span class="pi-brand"><strong>Circuit Stats</strong> · Player Websites</span>
    </nav>

    {/* The wizard opens by itself; this block is the landing for the second
        before it does, and the way back in after a close. */}
    <main class="pi-main">
      <h1 class="pi-h">Let&rsquo;s get your website right.</h1>
      <p class="pi-sub">A few questions about you, your film, and how you want it to look. Takes about 5 minutes, and your answers save as you go &mdash; you can leave and finish later on the same device.</p>
      <button class="pi-btn" id="pi-start" type="button" data-intake-open>Start</button>
    </main>
  </div>

  <IntakeWizard pipeline />

  <script is:inline>
    // Auto-open: the person was sent here to fill the form, so the form is the
    // page. The button stays behind it as the way back in after Leave/Escape.
    (function () {
      var relabel = function () {
        if (window.csIntakeHasDraft && window.csIntakeHasDraft()) {
          document.getElementById('pi-start').textContent = 'Continue where you left off';
        }
      };
      relabel();
      setTimeout(function () {
        relabel();
        var b = document.getElementById('pi-start');
        if (b) b.click();
      }, 150);
    })();
  </script>
</Layout>

<style>
  .pi-page{
    min-height:100dvh;background:#050a17;color:#e9eef8;
    font-family:'Archivo',system-ui,sans-serif;
    display:flex;flex-direction:column;
  }
  .pi-nav{
    display:flex;align-items:center;gap:11px;
    padding:18px clamp(20px,5vw,48px);border-bottom:1px solid #10192e;
  }
  .pi-logo{transform:scale(.82);transform-origin:left center}
  .pi-brand{font-size:14px;color:#8b9ab5}
  .pi-brand strong{color:#e9eef8;font-weight:800}
  .pi-main{
    flex:1;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;
    max-width:560px;margin:0 auto;padding:48px clamp(20px,5vw,48px) 96px;
  }
  .pi-h{margin:0 0 12px;font-size:clamp(26px,4.5vw,34px);font-weight:900;letter-spacing:-.018em;line-height:1.15}
  .pi-sub{margin:0 0 26px;font-size:15.5px;line-height:1.6;color:#8b9ab5;max-width:46ch}
  .pi-btn{
    min-height:52px;padding:14px 34px;border:none;border-radius:12px;cursor:pointer;
    background:#f2a83b;color:#131313;font-family:inherit;font-size:16.5px;font-weight:700;
    transition:background .15s,transform .1s;
  }
  .pi-btn:hover{background:#f6b757}
  .pi-btn:active{transform:translateY(1px)}
  .pi-btn:focus-visible{outline:2px solid rgba(242,168,59,.55);outline-offset:3px}
</style>
